-- M7 s1: wrong p. A proof of natLt (finVal i) 3 does not give allFin 3 of natLt (finVal i) 2 (false at i = 2).
theorem lt3 : (i : Fin 3) -> Holds (natLt (finVal i) 3) := fun (i : Fin 3) => finValLt 3 i
theorem bad : Holds (allFin 3 (fun (i : Fin 3) => natLt (finVal i) 2)) := allFinIntro 3 (fun (i : Fin 3) => natLt (finVal i) 2) lt3
