-- M7 s1: one fixed i as a constant function. A proof of Holds (p i) at i = 0 for each i does not give allFin 3 of natLt (finVal i) 1.
theorem const0 : (i : Fin 3) -> Holds (natLt 0 1) := fun (i : Fin 3) => decide (natLt 0 1)
theorem bad : Holds (allFin 3 (fun (i : Fin 3) => natLt (finVal i) 1)) := allFinIntro 3 (fun (i : Fin 3) => natLt (finVal i) 1) const0
