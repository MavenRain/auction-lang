-- M5 K3b: the normal-form rules ring, ringNat, field, cert, certLt and the
-- table rule sqNonneg.
theorem k3bRing : (x : Rat) -> (y : Rat) -> Eq Rat (ratMul (ratAdd x y) (ratAdd x y)) (ratAdd (ratAdd (ratMul x x) (ratMul 2/1 (ratMul x y))) (ratMul y y)) := fun x => fun y => ring (ratMul (ratAdd x y) (ratAdd x y)) (ratAdd (ratAdd (ratMul x x) (ratMul 2/1 (ratMul x y))) (ratMul y y))
theorem k3bRingSub : (x : Rat) -> (y : Rat) -> Eq Rat (ratSub (ratAdd x y) y) (ratDiv (ratMul 2/1 x) 2/1) := fun x => fun y => ring (ratSub (ratAdd x y) y) (ratDiv (ratMul 2/1 x) 2/1)
theorem k3bRingCast : (a : Nat) -> (b : Nat) -> Eq Rat (ratOfNat (natMul (natAdd a 1) b)) (ratAdd (ratMul (ratOfNat a) (ratOfNat b)) (ratOfNat b)) := fun a => fun b => ring (ratOfNat (natMul (natAdd a 1) b)) (ratAdd (ratMul (ratOfNat a) (ratOfNat b)) (ratOfNat b))
theorem k3bRingNat : (a : Nat) -> (b : Nat) -> Eq Nat (natMul (natAdd a b) 2) (natAdd (natAdd a b) (natAdd b a)) := fun a => fun b => ringNat (natMul (natAdd a b) 2) (natAdd (natAdd a b) (natAdd b a))
theorem k3bField : (x : Rat) -> Ne Rat x 0/1 -> Eq Rat (ratDiv x x) 1/1 := fun x => fun h => field (ratDiv x x) 1/1 (Ne Rat x 0/1) h
theorem k3bFieldAdd : (x : Rat) -> (y : Rat) -> Ne Rat y 0/1 -> Eq Rat (ratAdd (ratDiv x y) 1/1) (ratDiv (ratAdd x y) y) := fun x => fun y => fun h => field (ratAdd (ratDiv x y) 1/1) (ratDiv (ratAdd x y) y) (Ne Rat y 0/1) h
theorem k3bSqNonneg : (x : Rat) -> RatLe 0/1 (ratMul x x) := fun x => sqNonneg x
theorem k3bCert : (x : Rat) -> (y : Rat) -> RatLe (ratMul 2/1 (ratMul x y)) (ratAdd (ratMul x x) (ratMul y y)) := fun x => fun y => cert (ratMul 2/1 (ratMul x y)) (ratAdd (ratMul x x) (ratMul y y)) (RatLe 0/1 (ratMul (ratSub x y) (ratSub x y))) (sqNonneg (ratSub x y))
theorem k3bCertTwo : (x : Rat) -> (y : Rat) -> (z : Rat) -> RatLe 0/1 y -> RatLe 0/1 z -> RatLe x (ratAdd (ratAdd x (ratAdd y z)) 1/2) := fun x => fun y => fun z => fun hy => fun hz => cert x (ratAdd (ratAdd x (ratAdd y z)) 1/2) (And (RatLe 0/1 y) (RatLe 0/1 z)) (andIntro (RatLe 0/1 y) (RatLe 0/1 z) hy hz)
theorem k3bCertLt : (x : Rat) -> RatLt x (ratAdd x 1/1) := fun x => certLt x (ratAdd x 1/1) True trivial
theorem k3bCertLtHyp : (x : Rat) -> (y : Rat) -> RatLt x y -> RatLt (ratAdd x 1/2) (ratAdd y 1/2) := fun x => fun y => fun h => certLt (ratAdd x 1/2) (ratAdd y 1/2) (RatLt x y) h
theorem sumRat_add : (n : Nat) -> (f : Fin n -> Rat) -> (g : Fin n -> Rat) -> Eq Rat (sumRat n (fun i => ratAdd (f i) (g i))) (ratAdd (sumRat n f) (sumRat n g)) := natInd (fun (n : Nat) => (f : Fin n -> Rat) -> (g : Fin n -> Rat) -> Eq Rat (sumRat n (fun i => ratAdd (f i) (g i))) (ratAdd (sumRat n f) (sumRat n g))) (fun f => fun g => ring (sumRat 0 (fun i => ratAdd (f i) (g i))) (ratAdd (sumRat 0 f) (sumRat 0 g))) (fun k => fun ih => fun f => fun g => trans (sumRatSucc k (fun i => ratAdd (f i) (g i))) (trans (cong (fun (t : Rat) => ratAdd (ratAdd (f (finZero k)) (g (finZero k))) t) (ih (fun i => f (finSucc k i)) (fun i => g (finSucc k i)))) (trans (ring (ratAdd (ratAdd (f (finZero k)) (g (finZero k))) (ratAdd (sumRat k (fun i => f (finSucc k i))) (sumRat k (fun i => g (finSucc k i))))) (ratAdd (ratAdd (f (finZero k)) (sumRat k (fun i => f (finSucc k i)))) (ratAdd (g (finZero k)) (sumRat k (fun i => g (finSucc k i)))))) (trans (cong (fun (t : Rat) => ratAdd t (ratAdd (g (finZero k)) (sumRat k (fun i => g (finSucc k i))))) (symm (sumRatSucc k f))) (cong (fun (t : Rat) => ratAdd (sumRat (natAdd k 1) f) t) (symm (sumRatSucc k g)))))))
theorem sumRat_const_mul : (c : Rat) -> (n : Nat) -> (f : Fin n -> Rat) -> Eq Rat (sumRat n (fun i => ratMul c (f i))) (ratMul c (sumRat n f)) := fun c => natInd (fun (n : Nat) => (f : Fin n -> Rat) -> Eq Rat (sumRat n (fun i => ratMul c (f i))) (ratMul c (sumRat n f))) (fun f => ring (sumRat 0 (fun i => ratMul c (f i))) (ratMul c (sumRat 0 f))) (fun k => fun ih => fun f => trans (sumRatSucc k (fun i => ratMul c (f i))) (trans (cong (fun (t : Rat) => ratAdd (ratMul c (f (finZero k))) t) (ih (fun i => f (finSucc k i)))) (trans (ring (ratAdd (ratMul c (f (finZero k))) (ratMul c (sumRat k (fun i => f (finSucc k i))))) (ratMul c (ratAdd (f (finZero k)) (sumRat k (fun i => f (finSucc k i)))))) (cong (fun (t : Rat) => ratMul c t) (symm (sumRatSucc k f))))))
theorem sumRat_le : (n : Nat) -> (f : Fin n -> Rat) -> (g : Fin n -> Rat) -> ((i : Fin n) -> RatLe (f i) (g i)) -> RatLe (sumRat n f) (sumRat n g) := natInd (fun (n : Nat) => (f : Fin n -> Rat) -> (g : Fin n -> Rat) -> ((i : Fin n) -> RatLe (f i) (g i)) -> RatLe (sumRat n f) (sumRat n g)) (fun f => fun g => fun h => cert (sumRat 0 f) (sumRat 0 g) True trivial) (fun k => fun ih => fun f => fun g => fun h => transport (fun (t : Rat) => RatLe (sumRat (natAdd k 1) f) t) (symm (sumRatSucc k g)) (transport (fun (t : Rat) => RatLe t (ratAdd (g (finZero k)) (sumRat k (fun i => g (finSucc k i))))) (symm (sumRatSucc k f)) (cert (ratAdd (f (finZero k)) (sumRat k (fun i => f (finSucc k i)))) (ratAdd (g (finZero k)) (sumRat k (fun i => g (finSucc k i)))) (And (RatLe (f (finZero k)) (g (finZero k))) (RatLe (sumRat k (fun i => f (finSucc k i))) (sumRat k (fun i => g (finSucc k i))))) (andIntro (RatLe (f (finZero k)) (g (finZero k))) (RatLe (sumRat k (fun i => f (finSucc k i))) (sumRat k (fun i => g (finSucc k i)))) (h (finZero k)) (ih (fun i => f (finSucc k i)) (fun i => g (finSucc k i)) (fun i => h (finSucc k i)))))))
