def IsEfficient : (m : Nat) -> (x : (Fin m -> Rat) -> (Fin m -> Rat) -> Fin m) -> Prop := fun (m : Nat) (x : (Fin m -> Rat) -> (Fin m -> Rat) -> Fin m) => (r1 : Fin m -> Rat) -> (r2 : Fin m -> Rat) -> (y : Fin m) -> RatLe (l4W m r1 r2 y) (l4W m r1 r2 (x r1 r2))
def IsPivot : (m : Nat) -> (h : (Fin m -> Rat) -> Rat) -> Prop := fun (m : Nat) (h : (Fin m -> Rat) -> Rat) => (r2 : Fin m -> Rat) -> And ((y : Fin m) -> RatLe (r2 y) (h r2)) (Exists (Fin m) (fun (y : Fin m) => Eq Rat (h r2) (r2 y)))
def l4VCGPay : (m : Nat) -> (x : (Fin m -> Rat) -> (Fin m -> Rat) -> Fin m) -> (h : (Fin m -> Rat) -> Rat) -> (r1 : Fin m -> Rat) -> (r2 : Fin m -> Rat) -> Rat := fun (m : Nat) (x : (Fin m -> Rat) -> (Fin m -> Rat) -> Fin m) (h : (Fin m -> Rat) -> Rat) (r1 : Fin m -> Rat) (r2 : Fin m -> Rat) => ratSub (h r2) (r2 (x r1 r2))
def l4VCGU : (m : Nat) -> (x : (Fin m -> Rat) -> (Fin m -> Rat) -> Fin m) -> (h : (Fin m -> Rat) -> Rat) -> (v1 : Fin m -> Rat) -> (r1 : Fin m -> Rat) -> (r2 : Fin m -> Rat) -> Rat := fun (m : Nat) (x : (Fin m -> Rat) -> (Fin m -> Rat) -> Fin m) (h : (Fin m -> Rat) -> Rat) (v1 : Fin m -> Rat) (r1 : Fin m -> Rat) (r2 : Fin m -> Rat) => ratSub (v1 (x r1 r2)) (l4VCGPay m x h r1 r2)
theorem vcg_truthful_dominant : (m : Nat) -> (x : (Fin m -> Rat) -> (Fin m -> Rat) -> Fin m) -> (h : (Fin m -> Rat) -> Rat) -> IsEfficient m x -> (v1 : Fin m -> Rat) -> (r1 : Fin m -> Rat) -> (r2 : Fin m -> Rat) -> RatLe (l4VCGU m x h v1 r1 r2) (l4VCGU m x h v1 v1 r2) := fun m => fun x => fun h => fun he => fun v1 => fun r1 => fun r2 => cert (ratSub (v1 (x r1 r2)) (ratSub (h r2) (r2 (x r1 r2)))) (ratSub (v1 (x v1 r2)) (ratSub (h r2) (r2 (x v1 r2)))) (RatLe (ratAdd (v1 (x r1 r2)) (r2 (x r1 r2))) (ratAdd (v1 (x v1 r2)) (r2 (x v1 r2)))) (he v1 r2 (x r1 r2))
theorem vcg_individually_rational : (m : Nat) -> (x : (Fin m -> Rat) -> (Fin m -> Rat) -> Fin m) -> (h : (Fin m -> Rat) -> Rat) -> IsEfficient m x -> IsPivot m h -> (v1 : Fin m -> Rat) -> (r2 : Fin m -> Rat) -> ((y : Fin m) -> RatLe 0/1 (v1 y)) -> RatLe 0/1 (l4VCGU m x h v1 v1 r2) := fun m => fun x => fun h => fun he => fun hp => fun v1 => fun r2 => fun hv => exElim (Fin m) (fun (y : Fin m) => Eq Rat (h r2) (r2 y)) (RatLe 0/1 (l4VCGU m x h v1 v1 r2)) (andRight ((y : Fin m) -> RatLe (r2 y) (h r2)) (Exists (Fin m) (fun (y : Fin m) => Eq Rat (h r2) (r2 y))) (hp r2)) (fun y => fun e => transport (fun (z : Rat) => RatLe 0/1 (ratSub (v1 (x v1 r2)) (ratSub z (r2 (x v1 r2))))) (symm e) (cert 0/1 (ratSub (v1 (x v1 r2)) (ratSub (r2 y) (r2 (x v1 r2)))) (And (RatLe (ratAdd (v1 y) (r2 y)) (ratAdd (v1 (x v1 r2)) (r2 (x v1 r2)))) (RatLe 0/1 (v1 y))) (andIntro (RatLe (ratAdd (v1 y) (r2 y)) (ratAdd (v1 (x v1 r2)) (r2 (x v1 r2)))) (RatLe 0/1 (v1 y)) (he v1 r2 y) (hv y))))
-- examples/multiunit.lang lines 4 to 17 and 46 to 50 (the M4 uniform price model and the demand reduction witness).
def muF : (t : Fin 4) -> Rat := fun (t : Fin 4) => 1/4
def muV : (t : Fin 4) -> Rat := fun (t : Fin 4) => ratOfNat (finVal t)
def muB : (k : Fin 13) -> Rat := fun (k : Fin 13) => ratMul 1/4 (ratOfNat (finVal k))
def muMin : (x y : Rat) -> Rat := fun (x y : Rat) => flagIf (ratLe x y) x y
def muMax : (x y : Rat) -> Rat := fun (x y : Rat) => flagIf (ratLe x y) y x
def muInd : (c : Flag) -> Rat := fun (c : Flag) => flagIf c 1/1 0/1
-- k units are left for m tied bids: each tied bid gets min(1, k/m) units.
def muShare : (k m : Rat) -> Rat := fun (k m : Rat) => flagIf (ratLe k 0/1) 0/1 (flagIf (ratLe m k) 1/1 (ratDiv k m))
-- Units that the bid z gets against the rival bids r1 and r2.
def muWin : (z r1 r2 : Rat) -> Rat := fun (z r1 r2 : Rat) => muShare (ratSub 2/1 (ratAdd (muInd (ratLt z r1)) (muInd (ratLt z r2)))) (ratAdd 1/1 (ratAdd (muInd (ratEq z r1)) (muInd (ratEq z r2))))
-- M&M ch. 7, uniform price: each winner pays the highest losing bid, that is
-- the lowest of the 3 bids.
def muUP : (z r1 r2 : Rat) -> Rat := fun (z r1 r2 : Rat) => muMin z (muMin r1 r2)
def muUU : (t : Fin 4) -> (z r1 r2 : Rat) -> Rat := fun (t : Fin 4) (z r1 r2 : Rat) => ratMul (muWin z r1 r2) (ratSub (muV t) (muUP z r1 r2))
def muAm : Rat := 3/1
def muAu : (x1 x2 y : Fin 4) -> Rat := fun (x1 x2 y : Fin 4) => ratMul (ratSub 2/1 (muWin (muV y) (muV x1) (muV x2))) (ratSub muAm (muUP (muV x1) (muV x2) (muV y)))
-- Against y = 2, the truthful bids 3, 3 get 2 and the reduced bids 3, 0 get 3.
-- So truthful bidding is not dominant for a multi unit bidder.
def muDemandRed : Flag := ratLt (muAu 3 3 2) (muAu 3 0 2)
-- 7.1 uniform price with unit demand, 3 bidders and 2 units: bidder 1 wins a unit when its bid is at least the lower rival bid muMin c1 c2 (the highest losing bid) and pays it. Truthful bids are dominant for all Rat values and bids, so on every grid (l4SPDom is the second price argument with the rival bid c). examples/multiunit.lang:16-19 (muUP, muUU, muUniformDominant; the M4 model shares a tie, here a tie goes to the bidder).
def l4UnifU : (v : Rat) -> (b : Rat) -> (c1 : Rat) -> (c2 : Rat) -> Rat := fun (v : Rat) (b : Rat) (c1 : Rat) (c2 : Rat) => flagIf (ratLe (muMin c1 c2) b) (ratSub v (muMin c1 c2)) 0/1
theorem l4SPDom : (v : Rat) -> (b : Rat) -> (c : Rat) -> RatLe (flagIf (ratLe c b) (ratSub v c) 0/1) (flagIf (ratLe c v) (ratSub v c) 0/1) := fun v => fun b => fun c => flagCases (fun (d : Flag) => Eq Flag (ratLe c v) d -> RatLe (flagIf (ratLe c b) (ratSub v c) 0/1) (flagIf d (ratSub v c) 0/1)) (fun e => flagCases (fun (d2 : Flag) => RatLe (flagIf d2 (ratSub v c) 0/1) (flagIf flagYes (ratSub v c) 0/1)) (ratLeRefl (ratSub v c)) (cert 0/1 (ratSub v c) (RatLe c v) e) (ratLe c b)) (fun e => flagCases (fun (d2 : Flag) => RatLe (flagIf d2 (ratSub v c) 0/1) (flagIf flagNo (ratSub v c) 0/1)) (orElim (RatLe c v) (RatLe v c) (RatLe (ratSub v c) 0/1) (ratLeTotal c v) (fun h => absurd (l1FlagYesNeNo (trans (symm h) e)) (RatLe (ratSub v c) 0/1)) (fun h => cert (ratSub v c) 0/1 (RatLe v c) h)) (ratLeRefl 0/1) (ratLe c b)) (ratLe c v) refl
theorem uniform_price_unit_demand_dominant : (v : Rat) -> (b : Rat) -> (c1 : Rat) -> (c2 : Rat) -> RatLe (l4UnifU v b c1 c2) (l4UnifU v v c1 c2) := fun v => fun b => fun c1 => fun c2 => l4SPDom v b (muMin c1 c2)
-- 7.1 demand reduction: with 2 units and a 2-unit demand of 3, 3 against a rival bid of 2, the bidder gains by reducing its second bid to 0 (the uniform price falls to the rival bid). examples/multiunit.lang:46-50 (muAm, muAu, muDemandRed).
theorem demand_reduction : RatLt (muAu 3 3 2) (muAu 3 0 2) := decide (ratLt (muAu 3 3 2) (muAu 3 0 2))
-- 7.1 the multi unit Vickrey auction is the VCG instance on the outcomes 0, 1 or 2 units for bidder 1 (Fin 3). l4MU values bidder 1's units and l4MURival values the remaining 2 - k units for bidder 2; truthful marginal reports are dominant for every efficient rule. examples/multiunit.lang:54-63 (muSecond, muVApay, muVBpay, muVAu, muVBu, muVickreyDominant).
def l4MU : (m1 : Rat) -> (m2 : Rat) -> (k : Fin 3) -> Rat := fun (m1 : Rat) (m2 : Rat) (k : Fin 3) => flagIf (finEq k 0) 0/1 (flagIf (finEq k 1) m1 (ratAdd m1 m2))
def l4MURival : (m1 : Rat) -> (m2 : Rat) -> (k : Fin 3) -> Rat := fun (m1 : Rat) (m2 : Rat) (k : Fin 3) => flagIf (finEq k 0) (ratAdd m1 m2) (flagIf (finEq k 1) m1 0/1)
theorem multi_unit_vickrey_feasible_welfare : Holds (allFin 3 (fun (k : Fin 3) => ratEq (l4W 3 (l4MU 3/1 2/1) (l4MURival 7/1 5/1) k) (flagIf (finEq k 0) 12/1 (flagIf (finEq k 1) 10/1 5/1)))) := decide (allFin 3 (fun (k : Fin 3) => ratEq (l4W 3 (l4MU 3/1 2/1) (l4MURival 7/1 5/1) k) (flagIf (finEq k 0) 12/1 (flagIf (finEq k 1) 10/1 5/1))))
theorem multi_unit_vickrey_dominant : (x : (Fin 3 -> Rat) -> (Fin 3 -> Rat) -> Fin 3) -> (h : (Fin 3 -> Rat) -> Rat) -> IsEfficient 3 x -> (m1 : Rat) -> (m2 : Rat) -> (a1 : Rat) -> (a2 : Rat) -> (w1 : Rat) -> (w2 : Rat) -> RatLe (l4VCGU 3 x h (l4MU m1 m2) (l4MU a1 a2) (l4MURival w1 w2)) (l4VCGU 3 x h (l4MU m1 m2) (l4MU m1 m2) (l4MURival w1 w2)) := fun x => fun h => fun he => fun m1 => fun m2 => fun a1 => fun a2 => fun w1 => fun w2 => vcg_truthful_dominant 3 x h he (l4MU m1 m2) (l4MU a1 a2) (l4MURival w1 w2)
-- examples/combinatorial.lang lines 1 to 53 (the M4 two object models and the witnesses).
-- M&M ch. 7: multiple objects, two different objects A and B, on discrete
-- values. Bidder 1 wants A only (value a), bidder 2 wants B only (value b),
-- bidder 3 wants the package AB only (value s). Values are in {0, 1, 2, 3}.
def cbV : (t : Fin 4) -> Rat := fun (t : Fin 4) => ratOfNat (finVal t)
def cbMax : (x y : Rat) -> Rat := fun (x y : Rat) => flagIf (ratLe x y) y x
-- VCG: the efficient allocation. Tie rule: bidders 1 and 2 win when a + b >= s.
def cbLocal : (a b s : Rat) -> Flag := fun (a b s : Rat) => ratLe s (ratAdd a b)
-- Each winner pays the welfare that the other bidders lose because of it:
-- bidder 1 pays max(b, s) - b, bidder 2 pays max(a, s) - a, bidder 3 pays a + b.
def cbPay1 : (a b s : Rat) -> Rat := fun (a b s : Rat) => flagIf (cbLocal a b s) (ratSub (cbMax b s) b) 0/1
def cbPay2 : (a b s : Rat) -> Rat := fun (a b s : Rat) => flagIf (cbLocal a b s) (ratSub (cbMax a s) a) 0/1
def cbPay3 : (a b s : Rat) -> Rat := fun (a b s : Rat) => flagIf (cbLocal a b s) 0/1 (ratAdd a b)
-- Utility of a bidder with the true value v and the report x; the other
-- reports follow.
def cbU1 : (v x b s : Rat) -> Rat := fun (v x b s : Rat) => flagIf (cbLocal x b s) (ratSub v (cbPay1 x b s)) 0/1
def cbU2 : (v x a s : Rat) -> Rat := fun (v x a s : Rat) => flagIf (cbLocal a x s) (ratSub v (cbPay2 a x s)) 0/1
def cbU3 : (v x a b : Rat) -> Rat := fun (v x a b : Rat) => flagIf (cbLocal a b x) 0/1 (ratSub v (cbPay3 a b x))
-- M&M ch. 7, VCG: truthful reports are dominant for each bidder, for every
-- true value, report and pair of other reports.
def cbDSIC1 : Flag := allFin 4 (fun (v : Fin 4) => allFin 4 (fun (x : Fin 4) => allFin 4 (fun (b : Fin 4) => allFin 4 (fun (s : Fin 4) => ratLe (cbU1 (cbV v) (cbV x) (cbV b) (cbV s)) (cbU1 (cbV v) (cbV v) (cbV b) (cbV s))))))
def cbDSIC2 : Flag := allFin 4 (fun (v : Fin 4) => allFin 4 (fun (x : Fin 4) => allFin 4 (fun (a : Fin 4) => allFin 4 (fun (s : Fin 4) => ratLe (cbU2 (cbV v) (cbV x) (cbV a) (cbV s)) (cbU2 (cbV v) (cbV v) (cbV a) (cbV s))))))
def cbDSIC3 : Flag := allFin 4 (fun (v : Fin 4) => allFin 4 (fun (x : Fin 4) => allFin 4 (fun (a : Fin 4) => allFin 4 (fun (b : Fin 4) => ratLe (cbU3 (cbV v) (cbV x) (cbV a) (cbV b)) (cbU3 (cbV v) (cbV v) (cbV a) (cbV b))))))
-- Truthful utilities are not negative (individual rationality).
def cbIR : Flag := allFin 4 (fun (a : Fin 4) => allFin 4 (fun (b : Fin 4) => allFin 4 (fun (s : Fin 4) => flagAnd (ratLe 0/1 (cbU1 (cbV a) (cbV a) (cbV b) (cbV s))) (flagAnd (ratLe 0/1 (cbU2 (cbV b) (cbV b) (cbV a) (cbV s))) (ratLe 0/1 (cbU3 (cbV s) (cbV s) (cbV a) (cbV b)))))))
def cbRev : (a b s : Fin 4) -> Rat := fun (a b s : Fin 4) => ratAdd (cbPay1 (cbV a) (cbV b) (cbV s)) (ratAdd (cbPay2 (cbV a) (cbV b) (cbV s)) (cbPay3 (cbV a) (cbV b) (cbV s)))
-- Low revenue: the seller and bidder 3 block the outcome when their joint
-- payoff (revenue plus the utility of bidder 3) is less than s. Then the VCG
-- outcome is not in the core.
def cbBlock : (a b s : Fin 4) -> Flag := fun (a b s : Fin 4) => ratLt (ratAdd (cbRev a b s) (cbU3 (cbV s) (cbV s) (cbV a) (cbV b))) (cbV s)
-- a = b = s = 3 gives revenue 0; a = b = 2, s = 3 gives revenue 2 < 3.
def cbNotCore : Flag := flagAnd (cbBlock 3 3 3) (cbBlock 2 2 3)
-- Revenue is not monotone in the bidders. A bidder with value 0 changes no
-- allocation and no payment, so b = 0 is the auction without bidder 2.
-- Bidders 1 and 3 (a = 2, s = 3) give revenue 2; add bidder 2 with b = 3
-- and the revenue drops to 1.
def cbNotMonotone : Flag := ratLt (cbRev 2 3 3) (cbRev 2 0 3)
-- Expected VCG revenue when a, b, s are i.i.d. with probability 1/4 each.
def cbExpRev : Rat := sumRat 4 (fun (a : Fin 4) => sumRat 4 (fun (b : Fin 4) => sumRat 4 (fun (s : Fin 4) => ratMul 1/64 (cbRev a b s))))
-- M&M ch. 7, the exposure problem. A synergy bidder has value 1 for A alone,
-- 1 for B alone and cbSyn = 4 for AB. A and B are sold in two separate second
-- price auctions. Its bids x1, x2 and the high rival bids r1, r2 are in
-- {0, ..., 4}; ties are split.
def cbSyn : Rat := 4/1
def cbV5 : (k : Fin 5) -> Rat := fun (k : Fin 5) => ratOfNat (finVal k)
def cbW : (x r : Fin 5) -> Rat := fun (x r : Fin 5) => flagIf (finLt r x) 1/1 (flagIf (finEq x r) 1/2 0/1)
def cbXU : (x1 x2 r1 r2 : Fin 5) -> Rat := fun (x1 x2 r1 r2 : Fin 5) => ratSub (ratAdd (ratMul (ratMul (cbW x1 r1) (cbW x2 r2)) cbSyn) (ratAdd (ratMul (cbW x1 r1) (ratSub 1/1 (cbW x2 r2))) (ratMul (cbW x2 r2) (ratSub 1/1 (cbW x1 r1))))) (ratAdd (ratMul (cbW x1 r1) (cbV5 r1)) (ratMul (cbW x2 r2) (cbV5 r2)))
-- A bid pair is unsafe when some rival bids give a loss. It misses the
-- package when some rival bids with r1 + r2 < cbSyn give less than the
-- package surplus cbSyn - r1 - r2.
def cbUnsafe : (x1 x2 : Fin 5) -> Flag := fun (x1 x2 : Fin 5) => flagNot (allFin 5 (fun (r1 : Fin 5) => allFin 5 (fun (r2 : Fin 5) => ratLe 0/1 (cbXU x1 x2 r1 r2))))
def cbMisses : (x1 x2 : Fin 5) -> Flag := fun (x1 x2 : Fin 5) => flagNot (allFin 5 (fun (r1 : Fin 5) => allFin 5 (fun (r2 : Fin 5) => flagIf (ratLt (ratAdd (cbV5 r1) (cbV5 r2)) cbSyn) (ratLe (ratSub cbSyn (ratAdd (cbV5 r1) (cbV5 r2))) (cbXU x1 x2 r1 r2)) (natEq 0 0))))
-- Every bid pair is unsafe or misses the package.
def cbExposure : Flag := allFin 5 (fun (x1 : Fin 5) => allFin 5 (fun (x2 : Fin 5) => flagIf (cbUnsafe x1 x2) (natEq 0 0) (cbMisses x1 x2)))
-- 7.3 two objects A and B, two bidders: the VCG instance on the outcomes nothing, A, B, AB for bidder 1 (Fin 4). l4CB values bidder 1's bundle (s the package value); l4CBRival values the complementary bundle AB, B, A, nothing for bidder 2. Dominance and IR hold for every efficient rule and attained pivot. examples/combinatorial.lang (cbPay1, cbIR).
def l4CB : (a : Rat) -> (b : Rat) -> (s : Rat) -> (k : Fin 4) -> Rat := fun (a : Rat) (b : Rat) (s : Rat) (k : Fin 4) => flagIf (finEq k 0) 0/1 (flagIf (finEq k 1) a (flagIf (finEq k 2) b s))
def l4CBRival : (a : Rat) -> (b : Rat) -> (s : Rat) -> (k : Fin 4) -> Rat := fun (a : Rat) (b : Rat) (s : Rat) (k : Fin 4) => flagIf (finEq k 0) s (flagIf (finEq k 1) b (flagIf (finEq k 2) a 0/1))
theorem two_object_vcg_feasible_welfare : Holds (allFin 4 (fun (k : Fin 4) => ratEq (l4W 4 (l4CB 2/1 5/1 11/1) (l4CBRival 3/1 7/1 13/1) k) (flagIf (finEq k 0) 13/1 (flagIf (finEq k 1) 9/1 (flagIf (finEq k 2) 8/1 11/1))))) := decide (allFin 4 (fun (k : Fin 4) => ratEq (l4W 4 (l4CB 2/1 5/1 11/1) (l4CBRival 3/1 7/1 13/1) k) (flagIf (finEq k 0) 13/1 (flagIf (finEq k 1) 9/1 (flagIf (finEq k 2) 8/1 11/1)))))
theorem two_object_vcg_dominant : (x : (Fin 4 -> Rat) -> (Fin 4 -> Rat) -> Fin 4) -> (h : (Fin 4 -> Rat) -> Rat) -> IsEfficient 4 x -> (a : Rat) -> (b : Rat) -> (s : Rat) -> (a2 : Rat) -> (b2 : Rat) -> (s2 : Rat) -> (w1 : Rat) -> (w2 : Rat) -> (w3 : Rat) -> RatLe (l4VCGU 4 x h (l4CB a b s) (l4CB a2 b2 s2) (l4CBRival w1 w2 w3)) (l4VCGU 4 x h (l4CB a b s) (l4CB a b s) (l4CBRival w1 w2 w3)) := fun x => fun h => fun he => fun a => fun b => fun s => fun a2 => fun b2 => fun s2 => fun w1 => fun w2 => fun w3 => vcg_truthful_dominant 4 x h he (l4CB a b s) (l4CB a2 b2 s2) (l4CBRival w1 w2 w3)
theorem two_object_vcg_ir : (x : (Fin 4 -> Rat) -> (Fin 4 -> Rat) -> Fin 4) -> (h : (Fin 4 -> Rat) -> Rat) -> IsEfficient 4 x -> IsPivot 4 h -> (a : Rat) -> (b : Rat) -> (s : Rat) -> (w1 : Rat) -> (w2 : Rat) -> (w3 : Rat) -> ((y : Fin 4) -> RatLe 0/1 (l4CB a b s y)) -> RatLe 0/1 (l4VCGU 4 x h (l4CB a b s) (l4CB a b s) (l4CBRival w1 w2 w3)) := fun x => fun h => fun he => fun hp => fun a => fun b => fun s => fun w1 => fun w2 => fun w3 => fun hv => vcg_individually_rational 4 x h he hp (l4CB a b s) (l4CBRival w1 w2 w3) hv
-- 7.3 witnesses over the M4 models, by decide: the VCG revenue is not monotone in the bids (cbRev 2 3 3 < cbRev 2 0 3, examples/combinatorial.lang:36), the VCG outcome is not in the core (two blocking coalitions, :29-31), and the exposure problem (a bidder with a package value who bids item by item is unsafe or misses, :44-53).
theorem revenue_not_monotone : RatLt (cbRev 2 3 3) (cbRev 2 0 3) := decide (ratLt (cbRev 2 3 3) (cbRev 2 0 3))
theorem vcg_outcome_not_in_core : Holds cbNotCore := decide cbNotCore
theorem exposure_problem : Holds cbExposure := decide cbExposure
