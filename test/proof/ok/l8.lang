theorem two_bidder_allocation_feasible : (a : Rat) -> (b : Rat) -> RatLe (ratAdd (l8W a b) (l8W b a)) 1/1 := fun a => fun b => cert (ratAdd (l8W a b) (l8W b a)) 1/1 (And (RatLe 0/1 (ratMul (ratSub 1/1 (l3Ind (ratLe 0/1 a))) (l8H a b))) (RatLe 0/1 (ratMul (ratSub 1/1 (l3Ind (ratLe 0/1 b))) (l8H b a)))) (andIntro (RatLe 0/1 (ratMul (ratSub 1/1 (l3Ind (ratLe 0/1 a))) (l8H a b))) (RatLe 0/1 (ratMul (ratSub 1/1 (l3Ind (ratLe 0/1 b))) (l8H b a))) (ratMulNonneg (ratSub 1/1 (l3Ind (ratLe 0/1 a))) (l8H a b) (cert 0/1 (ratSub 1/1 (l3Ind (ratLe 0/1 a))) (RatLe (l3Ind (ratLe 0/1 a)) 1/1) (l8IndLeOne (ratLe 0/1 a))) (l8HNonneg a b)) (ratMulNonneg (ratSub 1/1 (l3Ind (ratLe 0/1 b))) (l8H b a) (cert 0/1 (ratSub 1/1 (l3Ind (ratLe 0/1 b))) (RatLe (l3Ind (ratLe 0/1 b)) 1/1) (l8IndLeOne (ratLe 0/1 b))) (l8HNonneg b a)))
theorem two_bidder_tie_split : (a : Rat) -> RatLe 0/1 a -> Eq Rat (l8W a a) 1/2 := fun a => fun h => transport (fun (r : Rat) => Eq Rat (ratMul r (l8H a a)) 1/2) (symm (ifTrue Rat (ratLe 0/1 a) 1/1 0/1 h)) (ring (ratMul 1/1 (l8H a a)) 1/2 True trivial)
-- 6.4, interim (ruling F (a)): bidder 2 has the type j < n with the mass f j,
-- and l8Q n f phi k is the interim allocation of bidder 1 with the type k.
def l8Q : (n : Nat) -> (f : Nat -> Rat) -> (phi : Nat -> Rat) -> (k : Nat) -> Rat := fun (n : Nat) (f : Nat -> Rat) (phi : Nat -> Rat) (k : Nat) => sumRat n (fun (j : Fin n) => ratMul (f (finVal j)) (l8W (phi k) (phi (finVal j))))
theorem l8QNonneg : (n : Nat) -> (f : Nat -> Rat) -> (phi : Nat -> Rat) -> ((k : Nat) -> RatLe 0/1 (f k)) -> (k : Nat) -> RatLe 0/1 (l8Q n f phi k) := fun n => fun f => fun phi => fun hf => fun k => sumRat_nonneg n (fun (j : Fin n) => ratMul (f (finVal j)) (l8W (phi k) (phi (finVal j)))) (fun j => ratMulNonneg (f (finVal j)) (l8W (phi k) (phi (finVal j))) (hf (finVal j)) (l8WNonneg (phi k) (phi (finVal j))))
theorem two_bidder_interim_monotone : (n : Nat) -> (f : Nat -> Rat) -> (phi : Nat -> Rat) -> ((k : Nat) -> RatLe 0/1 (f k)) -> IsMonoNat n phi -> IsMonoNat n (l8Q n f phi) := fun n => fun f => fun phi => fun hf => fun hphi => fun k => fun hk => sumRat_le n (fun (j : Fin n) => ratMul (f (finVal j)) (l8W (phi k) (phi (finVal j)))) (fun (j : Fin n) => ratMul (f (finVal j)) (l8W (phi (natAdd k 1)) (phi (finVal j)))) (fun j => l8ProdMono (f (finVal j)) (f (finVal j)) (l8W (phi k) (phi (finVal j))) (l8W (phi (natAdd k 1)) (phi (finVal j))) (hf (finVal j)) (l8WNonneg (phi k) (phi (finVal j))) (ratLeRefl (f (finVal j))) (l8WMono (phi k) (phi (natAdd k 1)) (phi (finVal j)) (hphi k hk)))
-- 6.4, the discrete virtual value on the unit grid: phi k = k - (1 - F k) / f k
-- with 1 - F k = l3Tail n f k (mechanism.lang mcPhi). Regularity (ruling (a)) is
-- the hypothesis IsMonoNat n (l8Phi n f). The proofs above compare virtual
-- values only through flags, so no step divides by f k.
def l8Phi : (n : Nat) -> (f : Nat -> Rat) -> (k : Nat) -> Rat := fun (n : Nat) (f : Nat -> Rat) (k : Nat) => ratSub (ratOfNat k) (ratDiv (l3Tail n f k) (f k))
theorem two_bidder_auction_attains_bound : (n : Nat) -> (f : Nat -> Rat) -> ((k : Nat) -> RatLe 0/1 (f k)) -> IsMonoNat n (l8Phi n f) -> And (And (IsICNat n (l8Q n f (l8Phi n f)) (l3Env (l8Q n f (l8Phi n f)))) (IsIRNat n (l8Q n f (l8Phi n f)) (l3Env (l8Q n f (l8Phi n f))))) (Eq Rat (l3Rev n f (l3Env (l8Q n f (l8Phi n f)))) (l3VS n f (l8Q n f (l8Phi n f)))) := fun n => fun f => fun hf => fun hreg => virtual_value_auction_attains_bound n f (l8Q n f (l8Phi n f)) (two_bidder_interim_monotone n f (l8Phi n f) hf hreg) (l8QNonneg n f (l8Phi n f) hf)
-- The 4-type instance of examples/mechanism.lang (f = 1/4, values 0 to 3).
def mcV : (t : Fin 4) -> Rat := fun (t : Fin 4) => ratOfNat (finVal t)
def mcF : (t : Fin 4) -> Rat := fun (t : Fin 4) => 1/4
def mcCdf : (t : Fin 4) -> Rat := fun (t : Fin 4) => sumRat 4 (fun (j : Fin 4) => flagIf (finLe j t) (mcF j) 0/1)
def mcPhi : (t : Fin 4) -> Rat := fun (t : Fin 4) => ratSub (mcV t) (ratDiv (ratSub 1/1 (mcCdf t)) (mcF t))
def mcOptq : (a b : Fin 4) -> Rat := fun (a b : Fin 4) => flagIf (ratLt 0/1 (mcPhi a)) (flagIf (ratLt (mcPhi b) (mcPhi a)) 1/1 (flagIf (ratEq (mcPhi a) (mcPhi b)) 1/2 0/1)) 0/1
def mcOptQ : (a : Fin 4) -> Rat := fun (a : Fin 4) => sumRat 4 (fun (b : Fin 4) => ratMul (mcF b) (mcOptq a b))
-- l8Phi is mcPhi (-3, -1, 1, 3) and is regular on the grid, l8W is mcOptq,
-- l8Q is mcOptQ (0, 0, 5/8, 7/8), 2 l3Rev = 13/8 (mcOptRev, 2 bidders) and
-- l3Rev = l3VS.
def l8F4 : (k : Nat) -> Rat := fun (k : Nat) => 1/4
def l8Inst : Flag := flagAnd (flagAnd (allFin 3 (fun (k : Fin 3) => ratLe (l8Phi 4 l8F4 (finVal k)) (l8Phi 4 l8F4 (natAdd (finVal k) 1)))) (allFin 4 (fun (a : Fin 4) => flagAnd (ratEq (l8Phi 4 l8F4 (finVal a)) (mcPhi a)) (flagAnd (ratEq (l8Q 4 l8F4 (l8Phi 4 l8F4) (finVal a)) (mcOptQ a)) (allFin 4 (fun (b : Fin 4) => ratEq (l8W (mcPhi a) (mcPhi b)) (mcOptq a b))))))) (flagAnd (ratEq (ratMul 2/1 (l3Rev 4 l8F4 (l3Env (l8Q 4 l8F4 (l8Phi 4 l8F4))))) 13/8) (ratEq (l3Rev 4 l8F4 (l3Env (l8Q 4 l8F4 (l8Phi 4 l8F4)))) (l3VS 4 l8F4 (l8Q 4 l8F4 (l8Phi 4 l8F4)))))
theorem l8InstanceCheck : Holds l8Inst := decide l8Inst
