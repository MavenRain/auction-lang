theorem winners_curse_uniform_grid : Holds cvCurse := decide cvCurse
-- Ch 4 winner's curse with discrete signals, independent and correlated priors. examples/commonvalue.lang:51
theorem winners_curse_discrete : Holds cvDCurse := decide cvDCurse
-- Ch 4 the naive bid s + 1/2 loses on the grid. examples/commonvalue.lang:22
theorem wallet_naive_bid_loses_grid : Holds cvNaiveLoses := decide cvNaiveLoses
-- Ch 4 wallet game revenues: first price 2/3 = second price 2 * 1/3. examples/commonvalue.lang:26
theorem wallet_revenue_equivalence : Eq Rat cvRevFP cvRevSP := ring cvRevFP cvRevSP True trivial

