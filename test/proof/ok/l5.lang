theorem l3SumBelowAdd : (g : Nat -> Rat) -> (k : Nat) -> (r : Nat) -> Eq Rat (l3Below g k) (l3BelowInd g (natAdd k r) k) := fun g => fun k => fun r => symm (trans (sumRat_split k r (fun (x : Nat) => ratMul (l3Ind (natLt x k)) (g x))) (trans (cong (fun (s : Rat) => ratAdd s (sumRat r (fun (b : Fin r) => ratMul (l3Ind (natLt (natAdd k (finVal b)) k)) (g (natAdd k (finVal b)))))) (sumRat_congr k (fun (a : Fin k) => ratMul (l3Ind (natLt (finVal a) k)) (g (finVal a))) (fun (j : Fin k) => g (finVal j)) (fun a => trans (cong (fun (d : Flag) => ratMul (l3Ind d) (g (finVal a))) (finValLt k a)) (ring (ratMul (l3Ind flagYes) (g (finVal a))) (g (finVal a)) True trivial)))) (trans (cong (fun (s : Rat) => ratAdd (l3Below g k) s) (trans (sumRat_congr r (fun (b : Fin r) => ratMul (l3Ind (natLt (natAdd k (finVal b)) k)) (g (natAdd k (finVal b)))) (fun (b : Fin r) => 0/1) (fun b => trans (cong (fun (d : Flag) => ratMul (l3Ind d) (g (natAdd k (finVal b)))) (l3NoOfNot (natLt (natAdd k (finVal b)) k) (l3LtAddFalse k (finVal b)))) (ring (ratMul (l3Ind flagNo) (g (natAdd k (finVal b)))) 0/1 True trivial))) (sumRat_const_zero r))) (ring (ratAdd (l3Below g k) 0/1) (l3Below g k) True trivial))))
theorem l3SumBelow : (g : Nat -> Rat) -> (n : Nat) -> (k : Nat) -> NatLe k n -> Eq Rat (l3Below g k) (l3BelowInd g n k) := fun g => fun n => fun k => fun hkn => orElim (And (NatLe k n) (Eq Nat (natAdd (natSub n k) k) n)) (And (NatLt n k) (Eq Nat (natSub n k) 0)) (Eq Rat (l3Below g k) (l3BelowInd g n k)) (subSpec n k) (fun h1 => transport (fun (m : Nat) => Eq Rat (l3Below g k) (l3BelowInd g m k)) (trans (ringNat (natAdd k (natSub n k)) (natAdd (natSub n k) k)) (andRight (NatLe k n) (Eq Nat (natAdd (natSub n k) k) n) h1)) (l3SumBelowAdd g k (natSub n k))) (fun h2 => absurd (l3LtLeAbsurd n k (andLeft (NatLt n k) (Eq Nat (natSub n k) 0) h2) hkn) (Eq Rat (l3Below g k) (l3BelowInd g n k)))
-- M&M Ch 4: common values. Two bidders see independent signals s and t,
-- uniform on [0, 1]. The object has the same value V = s + t for both.
def cvGrid : (k : Fin 9) -> Rat := fun (k : Fin 9) => ratDiv (ratOfNat (finVal k)) 8/1
-- First price with the symmetric bid b. A bidder with signal s that bids
-- b(z) wins if t < z: payoff E[(s + t - b(z)) 1(t < z)] = s z + z^2/2 - b(z) z.
def cvPayB : (b : (x : Rat) -> Rat) -> (s z : Rat) -> Rat := fun (b : (x : Rat) -> Rat) (s z : Rat) => ratSub (ratAdd (ratMul s z) (ratMul 1/2 (ratMul z z))) (ratMul (b z) z)
-- The equilibrium bid b(s) = s.
def cvBidFP : (z : Rat) -> Rat := fun (z : Rat) => z
def cvBestFP : Flag := allFin 9 (fun (i : Fin 9) => allFin 9 (fun (j : Fin 9) => ratLe (cvPayB cvBidFP (cvGrid j) (cvGrid i)) (cvPayB cvBidFP (cvGrid j) (cvGrid j))))
-- Second price with the bid b(t) = c t, c = 2 (the bid v(s, s) = 2s). The
-- winner pays the rival bid: payoff E[(s + t - c t) 1(t < z)] = s z + z^2/2 - c z^2/2.
def cvSlopeSP : Rat := 2/1
def cvPaySP : (s z : Rat) -> Rat := fun (s z : Rat) => ratSub (ratAdd (ratMul s z) (ratMul 1/2 (ratMul z z))) (ratMul cvSlopeSP (ratMul 1/2 (ratMul z z)))
def cvBestSP : Flag := allFin 9 (fun (i : Fin 9) => allFin 9 (fun (j : Fin 9) => ratLe (cvPaySP (cvGrid j) (cvGrid i)) (cvPaySP (cvGrid j) (cvGrid j))))
-- Winner's curse: E[V | s] = s + 1/2, but E[V | s, win] = s + E[t | t < s] = s + s/2.
def cvSig : (k : Fin 8) -> Rat := fun (k : Fin 8) => ratDiv (ratOfNat (finVal k)) 8/1
def cvMeanWin : (s : Rat) -> Rat := fun (s : Rat) => ratAdd s (ratMul 1/2 s)
def cvCurse : Flag := allFin 8 (fun (k : Fin 8) => ratLt (cvMeanWin (cvSig k)) (ratAdd (cvSig k) 1/2))
-- A naive first price bid E[V | s] = s + 1/2 loses money: at z = s the payoff
-- s^2 + s^2/2 - (s + 1/2) s = (s^2 - s)/2 is negative for 0 < s < 1.
def cvNaive : (z : Rat) -> Rat := fun (z : Rat) => ratAdd z 1/2
def cvNaiveLoses : Flag := allFin 7 (fun (k : Fin 7) => ratLt (cvPayB cvNaive (ratDiv (ratOfNat (natAdd (finVal k) 1)) 8/1) (ratDiv (ratOfNat (natAdd (finVal k) 1)) 8/1)) 0/1)
-- Revenue: first price E[b(max)] = E[max] = 2/3; second price E[c min] = c/3.
def cvRevFP : Rat := 2/3
def cvRevSP : Rat := ratMul cvSlopeSP 1/3
def cvRevEquiv : Flag := ratEq cvRevFP cvRevSP
def cvInd : (s t : Fin 3) -> Rat := fun (s t : Fin 3) => 1/9
-- Correlated prior: weight 4, 2, 1 for |s - t| = 0, 1, 2, divided by 22.
def cvCor : (s t : Fin 3) -> Rat := fun (s t : Fin 3) => flagIf (finEq s t) 2/11 (flagIf (natEq (natAdd (finVal s) (finVal t)) 2) 1/22 1/11)
def cvVal : (s t : Fin 3) -> Rat := fun (s t : Fin 3) => ratOfNat (natAdd (finVal s) (finVal t))
-- Winner's curse with discrete signals: under an increasing symmetric
-- strategy, a win tells that t < s (or a tie). E[V | s, win] < E[V | s].
def cvWinW : (pr : (s t : Fin 3) -> Rat) -> (s t : Fin 3) -> Rat := fun (pr : (s t : Fin 3) -> Rat) (s t : Fin 3) => ratMul (pr s t) (flagIf (finLt t s) 1/1 (flagIf (finEq t s) 1/2 0/1))
def cvMeanV : (w : (s t : Fin 3) -> Rat) -> (s : Fin 3) -> Rat := fun (w : (s t : Fin 3) -> Rat) (s : Fin 3) => ratDiv (sumRat 3 (fun (t : Fin 3) => ratMul (w s t) (cvVal s t))) (sumRat 3 (fun (t : Fin 3) => w s t))
def cvDCurse : Flag := allFin 3 (fun (s : Fin 3) => flagAnd (ratLt (cvMeanV (cvWinW cvInd) s) (cvMeanV cvInd s)) (ratLt (cvMeanV (cvWinW cvCor) s) (cvMeanV cvCor s)))

-- Ch 2 / Ch 4 wallet game: first price b(z) = z and second price 2z are best replies for all s, z. examples/commonvalue.lang:9, :14
theorem wallet_first_price_best_reply : (s : Rat) -> (z : Rat) -> RatLe (cvPayB cvBidFP s z) (cvPayB cvBidFP s s) := fun s => fun z => cert (cvPayB cvBidFP s z) (cvPayB cvBidFP s s) (RatLe 0/1 (ratMul 1/2 (ratMul (ratSub s z) (ratSub s z)))) (ratMulNonneg 1/2 (ratMul (ratSub s z) (ratSub s z)) (cert 0/1 1/2 True trivial) (sqNonneg (ratSub s z)))
theorem wallet_second_price_best_reply : (s : Rat) -> (z : Rat) -> RatLe (cvPaySP s z) (cvPaySP s s) := fun s => fun z => cert (cvPaySP s z) (cvPaySP s s) (RatLe 0/1 (ratMul 1/2 (ratMul (ratSub s z) (ratSub s z)))) (ratMulNonneg 1/2 (ratMul (ratSub s z) (ratSub s z)) (cert 0/1 1/2 True trivial) (sqNonneg (ratSub s z)))
theorem wallet_first_price_grid : Holds cvBestFP := decide cvBestFP
theorem wallet_second_price_grid : Holds cvBestSP := decide cvBestSP
