-- M6 s9 (slice H part 2b): the mechanisms for every N on the profile layer
-- (finProj, prodRat, sumProd) and the order statistics for N > 2. Ruling H5 = a:
-- the highest other bid is a guest def (a fold over the grid of an allFin over
-- the profile) and a relation; no kernel change. Plan: book/m6-s9-plan.md.
-- The 2-bidder second price theorem and its lemmas (copies of l1.lang).
theorem l1FlagRefl : (b : Flag) -> Eq Flag b b := fun b => refl
theorem l1FlagYesNeNo : Eq Flag flagYes flagNo -> False := fun e => natLtIrrefl 0 (transport (fun (f : Flag) => NatLt 0 (flagIf f 1 0)) e (decide (natLt 0 1)))
theorem l1SubZeroOfNo : (a : Nat) -> (b : Nat) -> Eq Flag (natLe b a) flagNo -> Eq Nat (natSub a b) 0 := fun a => fun b => fun e => orElim (And (NatLe b a) (Eq Nat (natAdd (natSub a b) b) a)) (And (NatLt a b) (Eq Nat (natSub a b) 0)) (Eq Nat (natSub a b) 0) (subSpec a b) (fun h => absurd (l1FlagYesNeNo (trans (symm (andLeft (NatLe b a) (Eq Nat (natAdd (natSub a b) b) a) h)) e)) (Eq Nat (natSub a b) 0)) (fun h => andRight (NatLt a b) (Eq Nat (natSub a b) 0) h)
theorem l1SubSelf : (a : Nat) -> Eq Nat (natSub a a) 0 := fun a => orElim (And (NatLe a a) (Eq Nat (natAdd (natSub a a) a) a)) (And (NatLt a a) (Eq Nat (natSub a a) 0)) (Eq Nat (natSub a a) 0) (subSpec a a) (fun h => natLeAntisymm (natSub a a) 0 (ofNatLeRev (natSub a a) 0 (cert (ratOfNat (natSub a a)) (ratOfNat 0) (RatLe (ratOfNat (natAdd (natSub a a) a)) (ratOfNat a)) (ofNatLe (natAdd (natSub a a) a) a (transport (fun (t : Nat) => NatLe t a) (symm (andRight (NatLe a a) (Eq Nat (natAdd (natSub a a) a) a) h)) (natLeRefl a))))) (natZeroLe (natSub a a))) (fun h => andRight (NatLt a a) (Eq Nat (natSub a a) 0) h)
theorem vickrey_truthful_dominant : (n : Nat) -> (v : Fin n) -> (b1 : Fin n) -> (b2 : Fin n) -> NatLe (finVal (vickreyUtility n v b1 b2)) (finVal (vickreyUtility n v v b2)) := fun n => fun v => fun b1 => fun b2 => flagCases (fun (c : Flag) => Eq Flag (finLe b2 b1) c -> NatLe (finVal (flagIf c (finSub v (finVal b2)) (finSub v (finVal v)))) (finVal (vickreyUtility n v v b2))) (fun e1 => flagCases (fun (c : Flag) => Eq Flag (finLe b2 v) c -> NatLe (finVal (finSub v (finVal b2))) (finVal (flagIf c (finSub v (finVal b2)) (finSub v (finVal v))))) (fun e2 => natLeRefl (finVal (finSub v (finVal b2)))) (fun e2 => transport (fun (t : Nat) => NatLe t (finVal (finSub v (finVal v)))) (symm (l1SubZeroOfNo (finVal v) (finVal b2) e2)) (natZeroLe (finVal (finSub v (finVal v))))) (finLe b2 v) (l1FlagRefl (finLe b2 v))) (fun e1 => transport (fun (t : Nat) => NatLe t (finVal (vickreyUtility n v v b2))) (symm (l1SubSelf (finVal v))) (natZeroLe (finVal (vickreyUtility n v v b2)))) (finLe b2 b1) (l1FlagRefl (finLe b2 b1))
def l12Ind : (c : Flag) -> Rat := fun (c : Flag) => flagIf c 1/1 0/1
-- Item (i). l12Others k n x i t: each bid of the profile x other than the bid of bidder i is at most t.
def l12Others : (k : Nat) -> (n : Nat) -> (x : Fin (natPow k n)) -> (i : Fin n) -> (t : Nat) -> Flag := fun (k : Nat) (n : Nat) (x : Fin (natPow k n)) (i : Fin n) (t : Nat) => allFin n (fun (j : Fin n) => flagIf (finEq j i) flagYes (natLe (finVal (finProj k n x j)) t))
-- The highest other bid of bidder i as a fold: the count of the grid points t that some other bid is above.
def l12Hob : (k : Nat) -> (n : Nat) -> (x : Fin (natPow k n)) -> (i : Fin n) -> Rat := fun (k : Nat) (n : Nat) (x : Fin (natPow k n)) (i : Fin n) => sumRat k (fun (t : Fin k) => flagIf (l12Others k n x i (finVal t)) 0/1 1/1)
-- l12IsHob k n x i m: m is the highest other bid (each other bid is at most m, and m is 0 or some other bid is above m - 1).
def l12IsHob : (k : Nat) -> (n : Nat) -> (x : Fin (natPow k n)) -> (i : Fin n) -> (m : Fin k) -> Flag := fun (k : Nat) (n : Nat) (x : Fin (natPow k n)) (i : Fin n) (m : Fin k) => flagAnd (l12Others k n x i (finVal m)) (flagIf (natEq (finVal m) 0) flagYes (flagNot (l12Others k n x i (natSub (finVal m) 1))))
-- The second price utility of bidder i in Rat: ties go to the lowest bidder index, as in domain/auction.lang, and the winner pays the highest other bid.
def l12Sp : (k : Nat) -> (n : Nat) -> (x : Fin (natPow k n)) -> (i : Fin n) -> (v : Fin k) -> (b : Fin k) -> Rat := fun (k : Nat) (n : Nat) (x : Fin (natPow k n)) (i : Fin n) (v : Fin k) (b : Fin k) => flagIf (allFin n (fun (j : Fin n) => flagIf (finEq j i) flagYes (flagIf (finLt j i) (finLt (finProj k n x j) b) (finLe (finProj k n x j) b)))) (ratSub (ratOfNat (finVal v)) (l12Hob k n x i)) 0/1
-- Every N and every profile: the tie-winning Nat utility is dominant at the highest other bid m. l12Sp uses the bidder-index tie rule.
theorem l12SecondPriceDominant : (k : Nat) -> (n : Nat) -> (x : Fin (natPow k n)) -> (i : Fin n) -> (m : Fin k) -> Holds (l12IsHob k n x i m) -> (v : Fin k) -> (b : Fin k) -> NatLe (finVal (vickreyUtility k v b m)) (finVal (vickreyUtility k v v m)) := fun k => fun n => fun x => fun i => fun m => fun h => fun v => fun b => vickrey_truthful_dominant k v b m
-- The relation and the fold agree on each profile, bidder and m (k^N = 27, 16, 64).
theorem l12HobFold33 : Holds (allFin (natPow 3 3) (fun (x : Fin (natPow 3 3)) => allFin 3 (fun (i : Fin 3) => allFin 3 (fun (m : Fin 3) => flagIf (l12IsHob 3 3 x i m) (ratEq (ratOfNat (finVal m)) (l12Hob 3 3 x i)) (flagNot (ratEq (ratOfNat (finVal m)) (l12Hob 3 3 x i))))))) := decide (allFin (natPow 3 3) (fun (x : Fin (natPow 3 3)) => allFin 3 (fun (i : Fin 3) => allFin 3 (fun (m : Fin 3) => flagIf (l12IsHob 3 3 x i m) (ratEq (ratOfNat (finVal m)) (l12Hob 3 3 x i)) (flagNot (ratEq (ratOfNat (finVal m)) (l12Hob 3 3 x i)))))))
theorem l12HobFold24 : Holds (allFin (natPow 2 4) (fun (x : Fin (natPow 2 4)) => allFin 4 (fun (i : Fin 4) => allFin 2 (fun (m : Fin 2) => flagIf (l12IsHob 2 4 x i m) (ratEq (ratOfNat (finVal m)) (l12Hob 2 4 x i)) (flagNot (ratEq (ratOfNat (finVal m)) (l12Hob 2 4 x i))))))) := decide (allFin (natPow 2 4) (fun (x : Fin (natPow 2 4)) => allFin 4 (fun (i : Fin 4) => allFin 2 (fun (m : Fin 2) => flagIf (l12IsHob 2 4 x i m) (ratEq (ratOfNat (finVal m)) (l12Hob 2 4 x i)) (flagNot (ratEq (ratOfNat (finVal m)) (l12Hob 2 4 x i)))))))
theorem l12HobFold43 : Holds (allFin (natPow 4 3) (fun (x : Fin (natPow 4 3)) => allFin 3 (fun (i : Fin 3) => allFin 4 (fun (m : Fin 4) => flagIf (l12IsHob 4 3 x i m) (ratEq (ratOfNat (finVal m)) (l12Hob 4 3 x i)) (flagNot (ratEq (ratOfNat (finVal m)) (l12Hob 4 3 x i))))))) := decide (allFin (natPow 4 3) (fun (x : Fin (natPow 4 3)) => allFin 3 (fun (i : Fin 3) => allFin 4 (fun (m : Fin 4) => flagIf (l12IsHob 4 3 x i m) (ratEq (ratOfNat (finVal m)) (l12Hob 4 3 x i)) (flagNot (ratEq (ratOfNat (finVal m)) (l12Hob 4 3 x i)))))))
-- N = 3 (the l6 vickrey3 rows): for bidder 0 the highest other bid is finMax b1 b2 on each of the 27 profiles, and the general theorem gives dominance there.
theorem l12IsHobMax33 : Holds (allFin (natPow 3 3) (fun (x : Fin (natPow 3 3)) => l12IsHob 3 3 x 0 (finMax (finProj 3 3 x 1) (finProj 3 3 x 2)))) := decide (allFin (natPow 3 3) (fun (x : Fin (natPow 3 3)) => l12IsHob 3 3 x 0 (finMax (finProj 3 3 x 1) (finProj 3 3 x 2))))
theorem l12Vickrey3 : (x : Fin (natPow 3 3)) -> (v : Fin 3) -> (b : Fin 3) -> NatLe (finVal (vickreyUtility 3 v b (finMax (finProj 3 3 x 1) (finProj 3 3 x 2)))) (finVal (vickreyUtility 3 v v (finMax (finProj 3 3 x 1) (finProj 3 3 x 2)))) := fun x => fun v => fun b => l12SecondPriceDominant 3 3 x 0 (finMax (finProj 3 3 x 1) (finProj 3 3 x 2)) (allFinSpec (natPow 3 3) (fun (y : Fin (natPow 3 3)) => l12IsHob 3 3 y 0 (finMax (finProj 3 3 y 1) (finProj 3 3 y 2))) l12IsHobMax33 x) v b
-- The Rat second price utility: truthful bidding is dominant on each profile (k^N = 27, 16).
theorem l12SpDominant33 : Holds (allFin (natPow 3 3) (fun (x : Fin (natPow 3 3)) => allFin 3 (fun (i : Fin 3) => allFin 3 (fun (v : Fin 3) => allFin 3 (fun (b : Fin 3) => ratLe (l12Sp 3 3 x i v b) (l12Sp 3 3 x i v v)))))) := decide (allFin (natPow 3 3) (fun (x : Fin (natPow 3 3)) => allFin 3 (fun (i : Fin 3) => allFin 3 (fun (v : Fin 3) => allFin 3 (fun (b : Fin 3) => ratLe (l12Sp 3 3 x i v b) (l12Sp 3 3 x i v v))))))
theorem l12SpDominant24 : Holds (allFin (natPow 2 4) (fun (x : Fin (natPow 2 4)) => allFin 4 (fun (i : Fin 4) => allFin 2 (fun (v : Fin 2) => allFin 2 (fun (b : Fin 2) => ratLe (l12Sp 2 4 x i v b) (l12Sp 2 4 x i v v)))))) := decide (allFin (natPow 2 4) (fun (x : Fin (natPow 2 4)) => allFin 4 (fun (i : Fin 4) => allFin 2 (fun (v : Fin 2) => allFin 2 (fun (b : Fin 2) => ratLe (l12Sp 2 4 x i v b) (l12Sp 2 4 x i v v))))))
-- Equal bids go to the lowest bidder index, as in domain/auction.lang.
theorem l12TieWinner2 : Eq Rat (l12Sp 3 2 4 0 2 1) 1/1 := refl
theorem l12TieLoser2 : Eq Rat (l12Sp 3 2 4 1 2 1) 0/1 := refl
theorem l12TieWinner3 : Eq Rat (l12Sp 3 3 13 0 2 1) 1/1 := refl
theorem l12TieLoser3 : Eq Rat (l12Sp 3 3 13 1 2 1) 0/1 := refl
theorem l12TieLoser3Last : Eq Rat (l12Sp 3 3 13 2 2 1) 0/1 := refl
-- Item (ii). First price, N iid bidders: P(win at bid b) against n = N - 1 iid bids (a tie loses).
def l12Win : (k : Nat) -> (n : Nat) -> (p : Fin k -> Rat) -> (b : Fin k) -> Rat := fun (k : Nat) (n : Nat) (p : Fin k -> Rat) (b : Fin k) => sumRat (natPow k n) (fun (x : Fin (natPow k n)) => prodRat n (fun (i : Fin n) => ratMul (p (finProj k n x i)) (l12Ind (natLt (finVal (finProj k n x i)) (finVal b)))))
def l12FpPay : (k : Nat) -> (n : Nat) -> (p : Fin k -> Rat) -> (v : Nat) -> (b : Fin k) -> Rat := fun (k : Nat) (n : Nat) (p : Fin k -> Rat) (v : Nat) (b : Fin k) => ratMul (ratSub (ratOfNat v) (ratOfNat (finVal b))) (l12Win k n p b)
-- Every k and N: P(win at b) = F(b)^(N - 1), F(b) = sumRat k (p c if c < b) (k5MaxCdf at n = N - 1, t = b).
theorem l12FirstPriceWin : (k : Nat) -> (n : Nat) -> (p : Fin k -> Rat) -> (b : Fin k) -> Eq Rat (l12Win k n p b) (prodRat n (fun (i : Fin n) => sumRat k (fun (c : Fin k) => ratMul (p c) (l12Ind (natLt (finVal c) (finVal b)))))) := fun k => fun n => fun p => fun b => sumProd k n (fun (i : Fin n) => fun (c : Fin k) => ratMul (p c) (l12Ind (natLt (finVal c) (finVal b))))
theorem l12FirstPricePay : (k : Nat) -> (n : Nat) -> (p : Fin k -> Rat) -> (v : Nat) -> (b : Fin k) -> Eq Rat (l12FpPay k n p v b) (ratMul (ratSub (ratOfNat v) (ratOfNat (finVal b))) (prodRat n (fun (i : Fin n) => sumRat k (fun (c : Fin k) => ratMul (p c) (l12Ind (natLt (finVal c) (finVal b))))))) := fun k => fun n => fun p => fun v => fun b => cong (fun (y : Rat) => ratMul (ratSub (ratOfNat v) (ratOfNat (finVal b))) y) (l12FirstPriceWin k n p b)
