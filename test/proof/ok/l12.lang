theorem l12BestBid42 : Holds (allFin 4 (fun (b : Fin 4) => ratLe (l12FpPay 4 2 (fun (c : Fin 4) => 1/4) 3 b) (l12FpPay 4 2 (fun (c : Fin 4) => 1/4) 3 2))) := decide (allFin 4 (fun (b : Fin 4) => ratLe (l12FpPay 4 2 (fun (c : Fin 4) => 1/4) 3 b) (l12FpPay 4 2 (fun (c : Fin 4) => 1/4) 3 2)))
theorem l12Pay33 : Eq Rat (l12FpPay 3 3 (fun (c : Fin 3) => 1/3) 2 1) 1/27 := refl
-- Item (iii). The second highest bid is below t when at most one bid is at or above t.
def l12Second : (k : Nat) -> (n : Nat) -> (x : Fin (natPow k n)) -> (t : Nat) -> Flag := fun (k : Nat) (n : Nat) (x : Fin (natPow k n)) (t : Nat) => ratLe (sumRat n (fun (j : Fin n) => l12Ind (natLe t (finVal (finProj k n x j))))) 1/1
def l12SecondCdf : (k : Nat) -> (n : Nat) -> (p : Fin k -> Rat) -> (t : Nat) -> Rat := fun (k : Nat) (n : Nat) (p : Fin k -> Rat) (t : Nat) => sumRat (natPow k n) (fun (x : Fin (natPow k n)) => ratMul (prodRat n (fun (i : Fin n) => p (finProj k n x i))) (l12Ind (l12Second k n x t)))
def l12F : (k : Nat) -> (p : Fin k -> Rat) -> (t : Nat) -> Rat := fun (k : Nat) (p : Fin k -> Rat) (t : Nat) => sumRat k (fun (c : Fin k) => ratMul (p c) (l12Ind (natLt (finVal c) t)))
-- The closed form F^N + N (1 - F) F^(N - 1), F = l12F k p t.
def l12SecondForm : (k : Nat) -> (n : Nat) -> (p : Fin k -> Rat) -> (t : Nat) -> Rat := fun (k : Nat) (n : Nat) (p : Fin k -> Rat) (t : Nat) => ratAdd (prodRat n (fun (i : Fin n) => l12F k p t)) (ratMul (ratOfNat n) (ratMul (ratSub 1/1 (l12F k p t)) (prodRat (natSub n 1) (fun (i : Fin (natSub n 1)) => l12F k p t))))
-- The CDF of the second highest of N uniform bids by refl (k^N at most 81), with the values at three sizes.
theorem l12SecondCdf33a : Eq Rat (l12SecondCdf 3 3 (fun (c : Fin 3) => 1/3) 1) 7/27 := refl
theorem l12SecondForm33t1 : Eq Rat (l12SecondCdf 3 3 (fun (c : Fin 3) => 1/3) 1) (l12SecondForm 3 3 (fun (c : Fin 3) => 1/3) 1) := refl
theorem l12SecondForm33t2 : Eq Rat (l12SecondCdf 3 3 (fun (c : Fin 3) => 1/3) 2) (l12SecondForm 3 3 (fun (c : Fin 3) => 1/3) 2) := refl
theorem l12SecondForm24t1 : Eq Rat (l12SecondCdf 2 4 (fun (c : Fin 2) => 1/2) 1) (l12SecondForm 2 4 (fun (c : Fin 2) => 1/2) 1) := refl
theorem l12SecondForm43t2 : Eq Rat (l12SecondCdf 4 3 (fun (c : Fin 4) => 1/4) 2) (l12SecondForm 4 3 (fun (c : Fin 4) => 1/4) 2) := refl
theorem l12SecondForm34t2 : Eq Rat (l12SecondCdf 3 4 (fun (c : Fin 3) => 1/3) 2) (l12SecondForm 3 4 (fun (c : Fin 3) => 1/3) 2) := refl
theorem l12SecondCdf24 : Eq Rat (l12SecondCdf 2 4 (fun (c : Fin 2) => 1/2) 1) 5/16 := refl
theorem l12SecondCdf34 : Eq Rat (l12SecondCdf 3 4 (fun (c : Fin 3) => 1/3) 2) 16/27 := refl
-- Every k, N and j: P(bid j at or above t, each other bid below t) is a product of sums (sumProd).
theorem l12OneAbove : (k : Nat) -> (n : Nat) -> (p : Fin k -> Rat) -> (t : Nat) -> (j : Fin n) -> Eq Rat (sumRat (natPow k n) (fun (x : Fin (natPow k n)) => prodRat n (fun (i : Fin n) => ratMul (p (finProj k n x i)) (flagIf (finEq i j) (l12Ind (natLe t (finVal (finProj k n x i)))) (l12Ind (natLt (finVal (finProj k n x i)) t)))))) (prodRat n (fun (i : Fin n) => sumRat k (fun (c : Fin k) => ratMul (p c) (flagIf (finEq i j) (l12Ind (natLe t (finVal c))) (l12Ind (natLt (finVal c) t)))))) := fun k => fun n => fun p => fun t => fun j => sumProd k n (fun (i : Fin n) => fun (c : Fin k) => ratMul (p c) (flagIf (finEq i j) (l12Ind (natLe t (finVal c))) (l12Ind (natLt (finVal c) t))))
-- On each profile the event splits: all bids below t, or exactly one bid j at or above t (k^N = 27, 16).
theorem l12SecondSplit33 : Holds (allFin (natPow 3 3) (fun (x : Fin (natPow 3 3)) => allFin 3 (fun (t : Fin 3) => ratEq (l12Ind (l12Second 3 3 x (finVal t))) (ratAdd (prodRat 3 (fun (i : Fin 3) => l12Ind (natLt (finVal (finProj 3 3 x i)) (finVal t)))) (sumRat 3 (fun (j : Fin 3) => prodRat 3 (fun (i : Fin 3) => flagIf (finEq i j) (l12Ind (natLe (finVal t) (finVal (finProj 3 3 x i)))) (l12Ind (natLt (finVal (finProj 3 3 x i)) (finVal t)))))))))) := decide (allFin (natPow 3 3) (fun (x : Fin (natPow 3 3)) => allFin 3 (fun (t : Fin 3) => ratEq (l12Ind (l12Second 3 3 x (finVal t))) (ratAdd (prodRat 3 (fun (i : Fin 3) => l12Ind (natLt (finVal (finProj 3 3 x i)) (finVal t)))) (sumRat 3 (fun (j : Fin 3) => prodRat 3 (fun (i : Fin 3) => flagIf (finEq i j) (l12Ind (natLe (finVal t) (finVal (finProj 3 3 x i)))) (l12Ind (natLt (finVal (finProj 3 3 x i)) (finVal t))))))))))
theorem l12SecondSplit24 : Holds (allFin (natPow 2 4) (fun (x : Fin (natPow 2 4)) => allFin 2 (fun (t : Fin 2) => ratEq (l12Ind (l12Second 2 4 x (finVal t))) (ratAdd (prodRat 4 (fun (i : Fin 4) => l12Ind (natLt (finVal (finProj 2 4 x i)) (finVal t)))) (sumRat 4 (fun (j : Fin 4) => prodRat 4 (fun (i : Fin 4) => flagIf (finEq i j) (l12Ind (natLe (finVal t) (finVal (finProj 2 4 x i)))) (l12Ind (natLt (finVal (finProj 2 4 x i)) (finVal t)))))))))) := decide (allFin (natPow 2 4) (fun (x : Fin (natPow 2 4)) => allFin 2 (fun (t : Fin 2) => ratEq (l12Ind (l12Second 2 4 x (finVal t))) (ratAdd (prodRat 4 (fun (i : Fin 4) => l12Ind (natLt (finVal (finProj 2 4 x i)) (finVal t)))) (sumRat 4 (fun (j : Fin 4) => prodRat 4 (fun (i : Fin 4) => flagIf (finEq i j) (l12Ind (natLe (finVal t) (finVal (finProj 2 4 x i)))) (l12Ind (natLt (finVal (finProj 2 4 x i)) (finVal t))))))))))
