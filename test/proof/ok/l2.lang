-- 3.3: a truthful bid stays dominant under each increasing utility u. examples/riskaverse.lang raSPTruth is the grid form (u = sqrt). No Lean counterpart.
theorem vickrey_truthful_dominant_utility : (n : Nat) -> (u : Nat -> Rat) -> ((a : Nat) -> (b : Nat) -> NatLe a b -> RatLe (u a) (u b)) -> (v : Fin n) -> (b1 : Fin n) -> (b2 : Fin n) -> RatLe (u (finVal (vickreyUtility n v b1 b2))) (u (finVal (vickreyUtility n v v b2))) := fun n => fun u => fun hu => fun v => fun b1 => fun b2 => hu (finVal (vickreyUtility n v b1 b2)) (finVal (vickreyUtility n v v b2)) (vickrey_truthful_dominant n v b1 b2)
theorem vickrey_truthful_best_response_utility : (n : Nat) -> (u : Nat -> Rat) -> ((a : Nat) -> (b : Nat) -> NatLe a b -> RatLe (u a) (u b)) -> (s2 : (v : Fin n) -> Fin n) -> (p : (v : Fin n) -> Rat) -> ((v : Fin n) -> RatLe 0/1 (p v)) -> (t1 : (v : Fin n) -> Fin n) -> (v1 : Fin n) -> RatLe (sumRat n (fun (v2 : Fin n) => ratMul (p v2) (u (finVal (vickreyUtility n v1 (t1 v1) (s2 v2)))))) (sumRat n (fun (v2 : Fin n) => ratMul (p v2) (u (finVal (vickreyUtility n v1 v1 (s2 v2)))))) := fun n => fun u => fun hu => fun s2 => fun p => fun hp => fun t1 => fun v1 => sumRat_le n (fun (v2 : Fin n) => ratMul (p v2) (u (finVal (vickreyUtility n v1 (t1 v1) (s2 v2))))) (fun (v2 : Fin n) => ratMul (p v2) (u (finVal (vickreyUtility n v1 v1 (s2 v2))))) (fun v2 => cert (ratMul (p v2) (u (finVal (vickreyUtility n v1 (t1 v1) (s2 v2))))) (ratMul (p v2) (u (finVal (vickreyUtility n v1 v1 (s2 v2))))) (RatLe 0/1 (ratMul (p v2) (ratSub (u (finVal (vickreyUtility n v1 v1 (s2 v2)))) (u (finVal (vickreyUtility n v1 (t1 v1) (s2 v2))))))) (ratMulNonneg (p v2) (ratSub (u (finVal (vickreyUtility n v1 v1 (s2 v2)))) (u (finVal (vickreyUtility n v1 (t1 v1) (s2 v2))))) (hp v2) (cert 0/1 (ratSub (u (finVal (vickreyUtility n v1 v1 (s2 v2)))) (u (finVal (vickreyUtility n v1 (t1 v1) (s2 v2))))) (RatLe (u (finVal (vickreyUtility n v1 (t1 v1) (s2 v2)))) (u (finVal (vickreyUtility n v1 v1 (s2 v2))))) (vickrey_truthful_dominant_utility n u hu v1 (t1 v1) (s2 v2)))))
-- 3.4: two values vL < vH, P(vH) = p. The high type is indifferent on (vL, bbar]: the dsPay branch equals dsU (dsHighFlat). No Lean counterpart.
theorem ds_high_indifferent : (vL : Rat) -> (vH : Rat) -> (p : Rat) -> (b : Rat) -> Ne Rat (ratMul p (ratSub vH b)) 0/1 -> Eq Rat (ratMul (ratSub vH b) (ratAdd (ratSub 1/1 p) (ratMul p (dsG vL vH p b)))) (dsU vL vH p) := fun vL => fun vH => fun p => fun b => fun hd => field (ratMul (ratSub vH b) (ratAdd (ratSub 1/1 p) (ratMul p (dsG vL vH p b)))) (dsU vL vH p) (Ne Rat (ratMul p (ratSub vH b)) 0/1) hd
-- A bid above bbar wins for sure and pays more than the indifference payoff (dsHighOff).
theorem ds_high_above_bbar_worse : (vL : Rat) -> (vH : Rat) -> (p : Rat) -> (b : Rat) -> RatLt (dsBbar vL vH p) b -> RatLt (ratSub vH b) (dsU vL vH p) := fun vL => fun vH => fun p => fun b => fun h => certLt (ratSub vH b) (dsU vL vH p) (RatLt (dsBbar vL vH p) b) h
-- G is 0 at vL and 1 at bbar (dsGDist).
theorem ds_G_at_bbar : (vL : Rat) -> (vH : Rat) -> (p : Rat) -> Ne Rat (ratMul p (ratSub vH (dsBbar vL vH p))) 0/1 -> Eq Rat (dsG vL vH p (dsBbar vL vH p)) 1/1 := fun vL => fun vH => fun p => fun hd => field (dsG vL vH p (dsBbar vL vH p)) 1/1 (Ne Rat (ratMul p (ratSub vH (dsBbar vL vH p))) 0/1) hd
theorem ds_G_at_vL : (vL : Rat) -> (vH : Rat) -> (p : Rat) -> Ne Rat (ratMul p (ratSub vH vL)) 0/1 -> Eq Rat (dsG vL vH p vL) 0/1 := fun vL => fun vH => fun p => fun hd => field (dsG vL vH p vL) 0/1 (Ne Rat (ratMul p (ratSub vH vL)) 0/1) hd
-- Revenue equivalence for all vL, vH and p (dsRevEquiv), and the book case vL = 1, vH = 3, p = 1/3.
theorem ds_revenue_equivalence : (vL : Rat) -> (vH : Rat) -> (p : Rat) -> Eq Rat (dsRevFP vL vH p) (dsRevSP vL vH p) := fun vL => fun vH => fun p => ring (dsRevFP vL vH p) (dsRevSP vL vH p)
theorem ds_book_revenue : Eq Rat (dsRevFP 1/1 3/1 1/3) 11/9 := ring (dsRevFP 1/1 3/1 1/3) 11/9
theorem ds_book_bbar : Eq Rat (dsBbar 1/1 3/1 1/3) 5/3 := ring (dsBbar 1/1 3/1 1/3) 5/3
-- A reserve above the value support cannot sell the item.
theorem spsb_reserve_above_support_revenue_uniform : Eq Rat (l2ReserveRev2 2/1) 0/1 := ring (l2ReserveRev2 2/1) 0/1
theorem spsb_reserve_support_boundary_revenue_uniform : Eq Rat (l2ReserveRev2 1/1) 0/1 := ring (l2ReserveRev2 1/1) 0/1
