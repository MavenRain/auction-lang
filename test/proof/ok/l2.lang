def dsBbar : (vL vH p : Rat) -> Rat := fun (vL vH p : Rat) => ratAdd vL (ratMul p (ratSub vH vL))
def dsG : (vL vH p b : Rat) -> Rat := fun (vL vH p b : Rat) => ratDiv (ratMul (ratSub 1/1 p) (ratSub b vL)) (ratMul p (ratSub vH b))
def dsU : (vL vH p : Rat) -> Rat := fun (vL vH p : Rat) => ratMul (ratSub vH vL) (ratSub 1/1 p)
def dsPay : (vL vH p v b : Rat) -> Rat := fun (vL vH p v b : Rat) => flagIf (ratLt b vL) 0/1 (flagIf (ratEq b vL) (ratMul (ratSub v vL) (ratMul 1/2 (ratSub 1/1 p))) (flagIf (ratLe b (dsBbar vL vH p)) (ratMul (ratSub v b) (ratAdd (ratSub 1/1 p) (ratMul p (dsG vL vH p b)))) (ratSub v b)))
def dsRevFP : (vL vH p : Rat) -> Rat := fun (vL vH p : Rat) => ratMul 2/1 (ratAdd (ratMul p (ratSub (ratMul vH (ratAdd (ratSub 1/1 p) (ratMul 1/2 p))) (dsU vL vH p))) (ratMul (ratSub 1/1 p) (ratMul vL (ratMul 1/2 (ratSub 1/1 p)))))
def dsRevSP : (vL vH p : Rat) -> Rat := fun (vL vH p : Rat) => ratAdd (ratMul (ratMul p p) vH) (ratMul (ratSub 1/1 (ratMul p p)) vL)
def dsBid : (n : Nat) -> (z : Rat) -> Rat := fun (n : Nat) (z : Rat) => ratMul (ratDiv (ratOfNat (natSub n 1)) (ratOfNat n)) z
def dsPay2 : (v z : Rat) -> Rat := fun (v z : Rat) => ratMul (ratSub v (dsBid 2 z)) z
def dsPay3 : (v z : Rat) -> Rat := fun (v z : Rat) => ratMul (ratSub v (dsBid 3 z)) (ratMul z z)
-- 3.1.1, N = 2: the payoff polynomial for bid z/2 against a uniform rival (dsPay2). The auction interpretation uses v and z in [0, 1]. No Lean counterpart; examples/discrete.lang dsBestResp2 is the grid form.
theorem fpsb_uniform_bid_best_reply_n2 : (v : Rat) -> (z : Rat) -> RatLe (dsPay2 v z) (dsPay2 v v) := fun v => fun z => cert (dsPay2 v z) (dsPay2 v v) (RatLe 0/1 (ratMul 1/2 (ratMul (ratSub v z) (ratSub v z)))) (ratMulNonneg 1/2 (ratMul (ratSub v z) (ratSub v z)) (cert 0/1 1/2 True trivial) (sqNonneg (ratSub v z)))
-- 3.1.1, N = 3: the payoff polynomial for bid 2z/3 against uniform rivals (dsPay3), for v and z at least 0. The auction interpretation uses v and z in [0, 1]. No Lean counterpart; examples/discrete.lang dsBestResp3 is the grid form.
theorem fpsb_uniform_bid_best_reply_n3 : (v : Rat) -> (z : Rat) -> RatLe 0/1 v -> RatLe 0/1 z -> RatLe (dsPay3 v z) (dsPay3 v v) := fun v => fun z => fun hv => fun hz => cert (dsPay3 v z) (dsPay3 v v) (RatLe 0/1 (ratMul 1/3 (ratMul (ratMul (ratSub v z) (ratSub v z)) (ratAdd v (ratMul 2/1 z))))) (ratMulNonneg 1/3 (ratMul (ratMul (ratSub v z) (ratSub v z)) (ratAdd v (ratMul 2/1 z))) (cert 0/1 1/3 True trivial) (ratMulNonneg (ratMul (ratSub v z) (ratSub v z)) (ratAdd v (ratMul 2/1 z)) (sqNonneg (ratSub v z)) (cert 0/1 (ratAdd v (ratMul 2/1 z)) (And (RatLe 0/1 v) (RatLe 0/1 (ratMul 2/1 z))) (andIntro (RatLe 0/1 v) (RatLe 0/1 (ratMul 2/1 z)) hv (ratMulNonneg 2/1 z (cert 0/1 2/1 True trivial) hz)))))
-- 3.1.4: two bidders, values uniform on [0, 1], nonnegative reserve r. The revenue polynomial applies on [0, 1]; above 1 the item cannot sell and revenue is 0. Examples.lean:537 spsbReserve_revenue_eq_uniform is the grid form.
def l2ReservePoly2 : (r : Rat) -> Rat := fun (r : Rat) => ratAdd (ratMul 2/1 (ratMul (ratMul r r) (ratSub 1/1 r))) (ratMul (ratMul (ratSub 1/1 r) (ratSub 1/1 r)) (ratAdd r (ratMul 1/3 (ratSub 1/1 r))))
