theorem l9Down : (vL : Rat) -> (vH : Rat) -> (p : Rat) -> (a : Rat) -> (c : Rat) -> RatLt vL vH -> RatLt c a -> l9Eq vL vH p a c -> False := fun vL => fun vH => fun p => fun a => fun c => fun hv => fun hca => fun hE => ratLtIrrefl 0/1 (certLt 0/1 0/1 (And (RatLe (ratMul (ratSub vL c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2))) (ratMul (ratSub vL a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1)))) (And (RatLe (ratMul (ratSub vL c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2))) (ratMul (ratSub vL a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1)))) (And (RatLe (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2)))) (And (RatLe (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2)))) (RatLt vL vH))))) (andIntro (RatLe (ratMul (ratSub vL c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2))) (ratMul (ratSub vL a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1)))) (And (RatLe (ratMul (ratSub vL c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2))) (ratMul (ratSub vL a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1)))) (And (RatLe (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2)))) (And (RatLe (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2)))) (RatLt vL vH)))) (l9LeAt (l9Pay vL p a c c) (l9Pay vL p a c a) (ratMul (ratSub vL c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2))) (ratMul (ratSub vL a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (l9PayAt vL p a c c 0/1 1/2 (l9SLose a c hca) (l9STie c)) (l9PayAt vL p a c a 1/2 1/1 (l9STie a) (l9SWin c a hca)) (l9EqL vL vH p a c hE c)) (andIntro (RatLe (ratMul (ratSub vL c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2))) (ratMul (ratSub vL a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1)))) (And (RatLe (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2)))) (And (RatLe (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2)))) (RatLt vL vH))) (l9LeAt (l9Pay vL p a c c) (l9Pay vL p a c a) (ratMul (ratSub vL c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2))) (ratMul (ratSub vL a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (l9PayAt vL p a c c 0/1 1/2 (l9SLose a c hca) (l9STie c)) (l9PayAt vL p a c a 1/2 1/1 (l9STie a) (l9SWin c a hca)) (l9EqL vL vH p a c hE c)) (andIntro (RatLe (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2)))) (And (RatLe (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2)))) (RatLt vL vH)) (l9LeAt (l9Pay vH p a c a) (l9Pay vH p a c c) (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2))) (l9PayAt vH p a c a 1/2 1/1 (l9STie a) (l9SWin c a hca)) (l9PayAt vH p a c c 0/1 1/2 (l9SLose a c hca) (l9STie c)) (l9EqH vL vH p a c hE a)) (andIntro (RatLe (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2)))) (RatLt vL vH) (l9LeAt (l9Pay vH p a c a) (l9Pay vH p a c c) (ratMul (ratSub vH a) (ratAdd (ratMul (ratSub 1/1 p) 1/2) (ratMul p 1/1))) (ratMul (ratSub vH c) (ratAdd (ratMul (ratSub 1/1 p) 0/1) (ratMul p 1/2))) (l9PayAt vH p a c a 1/2 1/1 (l9STie a) (l9SWin c a hca)) (l9PayAt vH p a c c 0/1 1/2 (l9SLose a c hca) (l9STie c)) (l9EqH vL vH p a c hE a)) hv)))))
theorem l9Pool : (vL : Rat) -> (vH : Rat) -> (p : Rat) -> (b : Rat) -> RatLt vL vH -> l9Eq vL vH p b b -> False := fun vL => fun vH => fun p => fun b => fun hv => fun hE => orElim (RatLt b vH) (RatLe vH b) False (l9Tri b vH) (fun h => l9Pool1 vL vH p b h hE) (fun h => l9Pool2 vL vH p b hv h hE)
theorem l9Sep : (vL : Rat) -> (vH : Rat) -> (p : Rat) -> (a : Rat) -> (c : Rat) -> RatLt 0/1 p -> RatLt p 1/1 -> RatLt a c -> l9Eq vL vH p a c -> False := fun vL => fun vH => fun p => fun a => fun c => fun hp0 => fun hp1 => fun hac => fun hE => orElim (RatLt c vH) (RatLe vH c) False (l9Tri c vH) (fun h => l9Up vL vH p a c hp0 hac h hE) (fun h => l9Mid vL vH p a c hp0 hp1 hac h hE)
-- M&M 3.4: with two values and 0 < p < 1, no pure strategy (bL, bH) is a
-- symmetric equilibrium, for all Rat bids.
theorem no_pure_symmetric_equilibrium : (vL : Rat) -> (vH : Rat) -> (p : Rat) -> (bL : Rat) -> (bH : Rat) -> RatLt vL vH -> RatLt 0/1 p -> RatLt p 1/1 -> Not (l9Eq vL vH p bL bH) := fun vL => fun vH => fun p => fun bL => fun bH => fun hv => fun hp0 => fun hp1 => fun hE => orElim (RatLt bL bH) (RatLe bH bL) False (l9Tri bL bH) (fun h => l9Sep vL vH p bL bH hp0 hp1 h hE) (fun h => orElim (RatLt bH bL) (RatLe bL bH) False (l9Tri bH bL) (fun g => l9Down vL vH p bL bH hv g hE) (fun g => l9Pool vL vH p bL hv (transport (fun (t : Rat) => l9Eq vL vH p bL t) (ratLeAntisymm bH bL h g) hE)))
-- The parameters of examples/discrete.lang (vL = 0, vH = 1, p = 1/2), for all Rat bids.
theorem no_pure_equilibrium_half : (bL : Rat) -> (bH : Rat) -> Not (l9Eq 0/1 1/1 1/2 bL bH) := fun bL => fun bH => no_pure_symmetric_equilibrium 0/1 1/1 1/2 bL bH (decide (ratLt 0/1 1/1)) (decide (ratLt 0/1 1/2)) (decide (ratLt 1/2 1/1))
-- The grid of discrete.lang: on the bids k/8, l9Pay agrees with dsGridPay, and
-- no grid pair is an equilibrium against grid deviations.
def l9G : (k : Fin 9) -> Rat := fun (k : Fin 9) => ratMul dsTick (ratOfNat (finVal k))
def l9GridAgree : Flag := allFin 9 (fun (z : Fin 9) => allFin 9 (fun (bL : Fin 9) => allFin 9 (fun (bH : Fin 9) => flagAnd (ratEq (l9Pay 0/1 1/2 (l9G bL) (l9G bH) (l9G z)) (dsGridPay 0/1 z bL bH)) (ratEq (l9Pay 1/1 1/2 (l9G bL) (l9G bH) (l9G z)) (dsGridPay 1/1 z bL bH)))))
def l9GridNoEq : Flag := allFin 9 (fun (bL : Fin 9) => allFin 9 (fun (bH : Fin 9) => flagNot (allFin 9 (fun (z : Fin 9) => flagAnd (ratLe (l9Pay 0/1 1/2 (l9G bL) (l9G bH) (l9G z)) (l9Pay 0/1 1/2 (l9G bL) (l9G bH) (l9G bL))) (ratLe (l9Pay 1/1 1/2 (l9G bL) (l9G bH) (l9G z)) (l9Pay 1/1 1/2 (l9G bL) (l9G bH) (l9G bH)))))))
def l9Grid : Flag := flagAnd l9GridAgree l9GridNoEq
theorem l9GridCheck : Holds l9Grid := decide l9Grid
