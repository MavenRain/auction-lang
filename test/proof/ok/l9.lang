-- M6 s4 (M5 slice E): M&M 3.4, no pure symmetric equilibrium for all Rat bids.
-- Two bidders, values vL < vH, P(vH) = p with 0 < p < 1, first price, and a
-- tie splits 1/2 (as dsShare in examples/discrete.lang). The rival bids bL
-- when low and bH when high. For all Rat vL, vH, p, bL and bH, (bL, bH) is not
-- a pure equilibrium. The proof splits on the order of bL and bH (and of bH and
-- vH) and applies the equilibrium Pi at one explicit deviation per case and
-- type (no Exists). A decide check ties l9Pay to the grid of discrete.lang.
-- Copies from test/proof/ok/l3.lang lines 13 and 30 and examples/discrete.lang lines 40 to 42 (a file cannot import another file).
theorem l1FlagYesNeNo : Eq Flag flagYes flagNo -> False := fun e => natLtIrrefl 0 (transport (fun (f : Flag) => NatLt 0 (flagIf f 1 0)) e (decide (natLt 0 1)))
theorem l3NoOfNot : (c : Flag) -> (Holds c -> False) -> Eq Flag c flagNo := fun c => fun hn => flagCases (fun (d : Flag) => Eq Flag c d -> Eq Flag d flagNo) (fun e => absurd (hn e) (Eq Flag flagYes flagNo)) (fun e => refl) c refl
def dsTick : Rat := 1/8
def dsShare : (z r : Fin 9) -> Rat := fun (z r : Fin 9) => flagIf (finLt r z) 1/1 (flagIf (finEq z r) 1/2 0/1)
def dsGridPay : (v : Rat) -> (z bL bH : Fin 9) -> Rat := fun (v : Rat) (z bL bH : Fin 9) => ratMul (ratSub v (ratMul dsTick (ratOfNat (finVal z)))) (ratMul 1/2 (ratAdd (dsShare z bL) (dsShare z bH)))
-- l9S r z: the share of the bid z against the rival bid r (win 1, tie 1/2,
-- lose 0). When r < z is false, r <= z means r = z.
def l9S : (r z : Rat) -> Rat := fun (r z : Rat) => flagIf (ratLt r z) 1/1 (flagIf (ratLe r z) 1/2 0/1)
