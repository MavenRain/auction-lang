-- Slice B1: gameComp, halfShadeBidder and the first price deviators.
-- The score of gameComp f g against k equals the score of f against the score of g against k. f = halfShadeBidder 2; g copies the value and puts the middle value in the result.
-- k always selects the winning flag, so both score maps are the identity and a constant-zero update cannot pass.
-- halfShading 2 v = 0, so halfShadeBidder 2 has the view of the bidder that bids 0; at n = 3 its view is not the truthful view.
-- A deviator with the truthful bid gives the truthful score matrix; the half shading bid changes it (n = 3, reserve 1).
def gameCompScore2 : Flag := matEq (gameScore 2 2 2 (natMul 2 2) (natMul 2 2) (gameComp 2 2 2 (natMul 2 2) 2 (natMul 2 2) 2 2 (halfShadeBidder 2) (makeGame 2 (natMul 2 2) 2 (natMul 2 2) 2 (matCopy 2) (matOfFn (natMul 2 (natMul 2 2)) (natMul 2 2) (fun (i : Fin (natMul 2 (natMul 2 2))) => finPair 2 2 (finFirst 2 2 (finSecond 2 (natMul 2 2) i)) (finFirst 2 (natMul 2 2) i))))) (matOfFn 2 (natMul 2 2) (fun (b : Fin 2) => finPair 2 2 1 b))) (gameScore 2 2 2 (natMul 2 2) 2 (halfShadeBidder 2) (gameScore 2 (natMul 2 2) 2 (natMul 2 2) 2 (makeGame 2 (natMul 2 2) 2 (natMul 2 2) 2 (matCopy 2) (matOfFn (natMul 2 (natMul 2 2)) (natMul 2 2) (fun (i : Fin (natMul 2 (natMul 2 2))) => finPair 2 2 (finFirst 2 2 (finSecond 2 (natMul 2 2) i)) (finFirst 2 (natMul 2 2) i)))) (matOfFn 2 (natMul 2 2) (fun (b : Fin 2) => finPair 2 2 1 b))))
def halfShadeZero2 : Flag := flagAnd (matEq (gameView (halfShadeBidder 2)) (gameView (deviatorBidder 2 (fun (v : Fin 2) => finSub v (finVal v))))) (flagNot (matEq (gameView (halfShadeBidder 3)) (gameView (truthfulBidder 3))))
def fpsbDev1Check3 : Flag := flagAnd (matEq (fpsbAuctionDeviator1 3 (fun (v : Fin 3) => truthful 3 v)) (fpsbAuction 3)) (flagNot (matEq (fpsbAuctionDeviator1 3 (fun (v : Fin 3) => halfShading 3 v)) (fpsbAuction 3)))
def fpsbDev2Check3 : Flag := flagAnd (matEq (fpsbAuctionDeviator2 3 (fun (v : Fin 3) => truthful 3 v)) (fpsbAuction 3)) (flagNot (matEq (fpsbAuctionDeviator2 3 (fun (v : Fin 3) => halfShading 3 v)) (fpsbAuction 3)))
def fpsbResDev1Check3 : Flag := flagAnd (matEq (fpsbReserveAuctionDeviator1 3 1 (fun (v : Fin 3) => truthful 3 v)) (auctionScore 3 (fpsbReserve 3 1))) (flagNot (matEq (fpsbReserveAuctionDeviator1 3 1 (fun (v : Fin 3) => halfShading 3 v)) (auctionScore 3 (fpsbReserve 3 1))))
def fpsbResDev2Check3 : Flag := flagAnd (matEq (fpsbReserveAuctionDeviator2 3 1 (fun (v : Fin 3) => truthful 3 v)) (auctionScore 3 (fpsbReserve 3 1))) (flagNot (matEq (fpsbReserveAuctionDeviator2 3 1 (fun (v : Fin 3) => halfShading 3 v)) (auctionScore 3 (fpsbReserve 3 1))))
-- Slice B4: the deviator games of the kron form have the update of auctionGame3 (Vickrey3.lean:573, :721, :971).
-- With update3FnEq and view3Dev1FnEq to view3Dev3FnEq, this links the kron games to the factored games at n = 2.
def update3DevFnEq : (n : Nat) -> Flag :=
  fun (n : Nat) => flagAnd (matEq (gameUpdate (auctionGame3Deviator1 n (fun (v : Fin n) => halfShading n v))) (gameUpdate (auctionGame3 n))) (flagAnd (matEq (gameUpdate (auctionGame3Deviator2 n (fun (v : Fin n) => halfShading n v))) (gameUpdate (auctionGame3 n))) (matEq (gameUpdate (auctionGame3Deviator3 n (fun (v : Fin n) => halfShading n v))) (gameUpdate (auctionGame3 n))))
