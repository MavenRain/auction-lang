-- The proof rules of the kernel (M5). gen/embed.c copies this file into
-- build/kernel.c, and the checker reads it before the domain files. Only this
-- file can declare a rule (RULE_DECL_OUTSIDE_KERNEL). A rule has no body: the
-- checker takes its type as given. Each name here is a core name (rule R4).
-- A typing failure at an argument of a rule gives the code RULE_<NAME>.
rule True : Prop
rule trivial : True
rule False : Prop
-- absurd eliminates False into each type of Type 1 and below.
rule absurd : False -> (C : Type 1) -> C
rule And : Prop -> Prop -> Prop
rule andIntro : (P : Prop) -> (Q : Prop) -> P -> Q -> And P Q
rule andLeft : (P : Prop) -> (Q : Prop) -> And P Q -> P
rule andRight : (P : Prop) -> (Q : Prop) -> And P Q -> Q
-- orElim and exElim eliminate only into a Prop: the motive C is a Prop. A
-- Type k motive gives PROP_LARGE_ELIM.
rule Or : Prop -> Prop -> Prop
rule orLeft : (P : Prop) -> (Q : Prop) -> P -> Or P Q
rule orRight : (P : Prop) -> (Q : Prop) -> Q -> Or P Q
rule orElim : (P : Prop) -> (Q : Prop) -> (C : Prop) -> Or P Q -> (P -> C) -> (Q -> C) -> C
rule Exists : (A : Type 0) -> (A -> Prop) -> Prop
rule exIntro : (A : Type 0) -> (P : A -> Prop) -> (a : A) -> P a -> Exists A P
rule exElim : (A : Type 0) -> (P : A -> Prop) -> (C : Prop) -> Exists A P -> ((a : A) -> P a -> C) -> C
-- Definitions, not rules.
def Not : Prop -> Prop := fun P => P -> False
def Iff : Prop -> Prop -> Prop := fun P => fun Q => And (P -> Q) (Q -> P)
def Ne : (A : Type 0) -> A -> A -> Prop := fun A => fun a => fun b => Not (Eq A a b)
-- M5 K2. Holds b is the Prop of a Flag. NatLe, NatLt, RatLe and RatLt use
-- the comparison ops, so a closed instance checks by conversion.
def Holds : Flag -> Prop := fun b => Eq Flag b flagYes
def NatLe : Nat -> Nat -> Prop := fun a => fun b => Holds (natLe a b)
def NatLt : Nat -> Nat -> Prop := fun a => fun b => Holds (natLt a b)
def RatLe : Rat -> Rat -> Prop := fun a => fun b => Holds (ratLe a b)
def RatLt : Rat -> Rat -> Prop := fun a => fun b => Holds (ratLt a b)
-- decide has a check in C (check.c, decide_holds): the checker accepts
-- decide b only when b is closed and evaluates to flagYes (RULE_DECIDE).
rule decide : (b : Flag) -> Holds b
-- Induction on Nat and cases on Flag.
rule natInd : (P : Nat -> Prop) -> P 0 -> ((k : Nat) -> P k -> P (natAdd k 1)) -> (n : Nat) -> P n
rule flagCases : (P : Flag -> Prop) -> P flagYes -> P flagNo -> (b : Flag) -> P b
-- The equations of flagIf on an open Flag.
rule ifTrue : (A : Type 0) -> (c : Flag) -> (a : A) -> (b : A) -> Holds c -> Eq A (flagIf c a b) a
rule ifFalse : (A : Type 0) -> (c : Flag) -> (a : A) -> (b : A) -> Eq Flag c flagNo -> Eq A (flagIf c a b) b
-- Order on Nat and on Rat. These rules are true in the natural numbers and
-- in the rationals. A trap is not a value: conversion never makes a trap
-- equal to a term (eval.c, conv_loop), so a rule at a trap proves nothing.
rule natLeRefl : (a : Nat) -> NatLe a a
rule natLeTrans : (a : Nat) -> (b : Nat) -> (c : Nat) -> NatLe a b -> NatLe b c -> NatLe a c
rule natLeTotal : (a : Nat) -> (b : Nat) -> Or (NatLe a b) (NatLe b a)
rule natLeAntisymm : (a : Nat) -> (b : Nat) -> NatLe a b -> NatLe b a -> Eq Nat a b
rule natLtIrrefl : (a : Nat) -> Not (NatLt a a)
rule natLtIffSuccLe : (a : Nat) -> (b : Nat) -> Iff (NatLt a b) (NatLe (natAdd a 1) b)
rule natLtOfLeNe : (a : Nat) -> (b : Nat) -> NatLe a b -> Ne Nat a b -> NatLt a b
rule natAddLe : (a : Nat) -> (b : Nat) -> (c : Nat) -> (d : Nat) -> NatLe a b -> NatLe c d -> NatLe (natAdd a c) (natAdd b d)
rule natZeroLe : (a : Nat) -> NatLe 0 a
rule ratLeRefl : (a : Rat) -> RatLe a a
rule ratLeTrans : (a : Rat) -> (b : Rat) -> (c : Rat) -> RatLe a b -> RatLe b c -> RatLe a c
rule ratLeTotal : (a : Rat) -> (b : Rat) -> Or (RatLe a b) (RatLe b a)
rule ratLeAntisymm : (a : Rat) -> (b : Rat) -> RatLe a b -> RatLe b a -> Eq Rat a b
rule ratLtIrrefl : (a : Rat) -> Not (RatLt a a)
rule ratLtOfLeNe : (a : Rat) -> (b : Rat) -> RatLe a b -> Ne Rat a b -> RatLt a b
rule ratAddLe : (a : Rat) -> (b : Rat) -> (c : Rat) -> (d : Rat) -> RatLe a b -> RatLe c d -> RatLe (ratAdd a c) (ratAdd b d)
rule ratMulNonneg : (a : Rat) -> (b : Rat) -> RatLe 0/1 a -> RatLe 0/1 b -> RatLe 0/1 (ratMul a b)
-- The cast ratOfNat.
rule ofNatLe : (a : Nat) -> (b : Nat) -> NatLe a b -> RatLe (ratOfNat a) (ratOfNat b)
rule ofNatLeRev : (a : Nat) -> (b : Nat) -> RatLe (ratOfNat a) (ratOfNat b) -> NatLe a b
rule ofNatAdd : (a : Nat) -> (b : Nat) -> Eq Rat (ratOfNat (natAdd a b)) (ratAdd (ratOfNat a) (ratOfNat b))
rule ofNatMul : (a : Nat) -> (b : Nat) -> Eq Rat (ratOfNat (natMul a b)) (ratMul (ratOfNat a) (ratOfNat b))
rule ofNatNonneg : (a : Nat) -> RatLe 0/1 (ratOfNat a)
-- Specifications of the Nat, Flag, allFin and Fin built-ins.
rule subSpec : (a : Nat) -> (b : Nat) -> Or (And (NatLe b a) (Eq Nat (natAdd (natSub a b) b) a)) (And (NatLt a b) (Eq Nat (natSub a b) 0))
rule divModSpec : (a : Nat) -> (b : Nat) -> NatLt 0 b -> Eq Nat (natAdd (natMul b (natDiv a b)) (natMod a b)) a
rule modLt : (a : Nat) -> (b : Nat) -> NatLt 0 b -> NatLt (natMod a b) b
rule maxL : (a : Nat) -> (b : Nat) -> NatLe a (natMax a b)
rule maxR : (a : Nat) -> (b : Nat) -> NatLe b (natMax a b)
-- M5 L1b. The least upper bound of natMax (USER ruling R2 (a)).
rule natMaxLub : (a : Nat) -> (b : Nat) -> (c : Nat) -> NatLe a c -> NatLe b c -> NatLe (natMax a b) c
rule andSpec : (x : Flag) -> (y : Flag) -> Iff (Holds (flagAnd x y)) (And (Holds x) (Holds y))
rule notSpec : (x : Flag) -> Iff (Holds (flagNot x)) (Not (Holds x))
rule allFinSpec : (n : Nat) -> (p : Fin n -> Flag) -> Holds (allFin n p) -> (i : Fin n) -> Holds (p i)
-- M7 H3 (s1). The converse of allFinSpec (USER ruling H3a (a)).
rule allFinIntro : (n : Nat) -> (p : Fin n -> Flag) -> ((i : Fin n) -> Holds (p i)) -> Holds (allFin n p)
rule finValLt : (n : Nat) -> (i : Fin n) -> NatLt (finVal i) n
rule finExt : (n : Nat) -> (i : Fin n) -> (j : Fin n) -> Eq Nat (finVal i) (finVal j) -> Eq (Fin n) i j
-- M5 K3. natMin is a definition (USER ruling 6: Nat min is in for M5).
-- finZero and finSucc are built-ins (check.c, rule_fin_zero, rule_fin_succ).
def natMin : Nat -> Nat -> Nat := fun a => fun b => flagIf (natLe a b) a b
rule finCases : (n : Nat) -> (P : Fin (natAdd n 1) -> Prop) -> P (finZero n) -> ((i : Fin n) -> P (finSucc n i)) -> (i : Fin (natAdd n 1)) -> P i
rule finEmpty : Fin 0 -> False
rule finZeroVal : (n : Nat) -> Eq Nat (finVal (finZero n)) 0
rule finSuccVal : (n : Nat) -> (i : Fin n) -> Eq Nat (finVal (finSucc n i)) (natAdd (finVal i) 1)
rule pairFirst : (m : Nat) -> (n : Nat) -> (a : Fin m) -> (b : Fin n) -> Eq (Fin m) (finFirst m n (finPair m n a b)) a
rule pairSecond : (m : Nat) -> (n : Nat) -> (a : Fin m) -> (b : Fin n) -> Eq (Fin n) (finSecond m n (finPair m n a b)) b
rule pairVal : (m : Nat) -> (n : Nat) -> (a : Fin m) -> (b : Fin n) -> Eq Nat (finVal (finPair m n a b)) (natAdd (natMul m (finVal b)) (finVal a))
-- M6 H. A profile of n bids on the grid Fin k is a Fin (natPow k n). The bid
-- of bidder i is digit i in base k (finProj; bidder 0 is the low digit), and
-- finUpd replaces it. natPow, finProj and finUpd are built-ins (check.c,
-- rule_fin_proj, rule_fin_upd).
rule powZero : (k : Nat) -> Eq Nat (natPow k 0) 1
rule powSucc : (k : Nat) -> (n : Nat) -> Eq Nat (natPow k (natAdd n 1)) (natMul k (natPow k n))
rule projUpd : (k : Nat) -> (n : Nat) -> (x : Fin (natPow k n)) -> (i : Fin n) -> (b : Fin k) -> Eq (Fin k) (finProj k n (finUpd k n x i b) i) b
rule projUpdNe : (k : Nat) -> (n : Nat) -> (x : Fin (natPow k n)) -> (i : Fin n) -> (b : Fin k) -> (j : Fin n) -> Ne (Fin n) i j -> Eq (Fin k) (finProj k n (finUpd k n x i b) j) (finProj k n x j)
rule updProj : (k : Nat) -> (n : Nat) -> (x : Fin (natPow k n)) -> (i : Fin n) -> Eq (Fin (natPow k n)) (finUpd k n x i (finProj k n x i)) x
rule profExt : (k : Nat) -> (n : Nat) -> (x : Fin (natPow k n)) -> (y : Fin (natPow k n)) -> ((i : Fin n) -> Eq (Fin k) (finProj k n x i) (finProj k n y i)) -> Eq (Fin (natPow k n)) x y
-- The defining equations of sumRat and of the Nat fold on an open size.
rule sumRatZero : (f : Fin 0 -> Rat) -> Eq Rat (sumRat 0 f) 0/1
rule sumRatSucc : (n : Nat) -> (f : Fin (natAdd n 1) -> Rat) -> Eq Rat (sumRat (natAdd n 1) f) (ratAdd (f (finZero n)) (sumRat n (fun i => f (finSucc n i))))
-- M6 H (s8). prodRat is a built-in (check.c, rule_all_fin; eval.c,
-- reduce_prod_rat). sumProd is the App A product rule for N factors: a sum
-- over the profiles of a product of one factor per bidder is the product of
-- the sums. The 2-factor form is l5.lang sumRat_mul_sumRat.
rule prodRatZero : (f : Fin 0 -> Rat) -> Eq Rat (prodRat 0 f) 1/1
rule prodRatSucc : (n : Nat) -> (f : Fin (natAdd n 1) -> Rat) -> Eq Rat (prodRat (natAdd n 1) f) (ratMul (f (finZero n)) (prodRat n (fun i => f (finSucc n i))))
rule sumProd : (k : Nat) -> (n : Nat) -> (f : Fin n -> Fin k -> Rat) -> Eq Rat (sumRat (natPow k n) (fun (x : Fin (natPow k n)) => prodRat n (fun (i : Fin n) => f i (finProj k n x i)))) (prodRat n (fun (i : Fin n) => sumRat k (f i)))
rule foldZero : (A : Type 0) -> (f : A -> A) -> (x : A) -> Eq A (fold f x 0) x
rule foldSucc : (A : Type 0) -> (f : A -> A) -> (x : A) -> (n : Nat) -> Eq A (fold f x (natAdd n 1)) (f (fold f x n))
rule minL : (a : Nat) -> (b : Nat) -> NatLe (natMin a b) a
rule minR : (a : Nat) -> (b : Nat) -> NatLe (natMin a b) b
-- M5 K3b. ring, ringNat, field, cert and certLt have a check in C (nf.c,
-- check.c nf_holds): the checker accepts them only when the normal forms
-- agree. H joins the hypotheses with And (True: no hypothesis). Each divisor
-- d that is not a literal needs Ne Rat d 0/1 in H (all but ringNat; M6 L).
-- cert and certLt: H also gives RatLe x y or RatLt x y, and b - a - (the sum
-- of y - x) must be a constant >= 0 (certLt: > 0, or 0 with one RatLt fact).
rule ring : (a : Rat) -> (b : Rat) -> (H : Prop) -> H -> Eq Rat a b
rule ringNat : (a : Nat) -> (b : Nat) -> Eq Nat a b
rule field : (a : Rat) -> (b : Rat) -> (H : Prop) -> H -> Eq Rat a b
rule cert : (a : Rat) -> (b : Rat) -> (H : Prop) -> H -> RatLe a b
rule certLt : (a : Rat) -> (b : Rat) -> (H : Prop) -> H -> RatLt a b
rule sqNonneg : (x : Rat) -> RatLe 0/1 (ratMul x x)
