  fun (n : Nat) (r v oppBid myBid : Fin n) => flagIf (flagAnd (finLt oppBid myBid) (finLe r myBid)) (finSub v (finVal myBid)) (finSub v (finVal v))
def vickreyReserveUtility : (n : Nat) -> (v b1 b2 r : Fin n) -> Fin n :=
  fun (n : Nat) (v b1 b2 r : Fin n) => flagIf (flagAnd (finLe b2 b1) (finLe r b1)) (finSub v (finVal (finMax r b2))) (finSub v (finVal v))
def vickreyReserveBidder2Util : (n : Nat) -> (v oppBid myBid r : Fin n) -> Fin n :=
  fun (n : Nat) (v oppBid myBid r : Fin n) => flagIf (flagAnd (finLt oppBid myBid) (finLe r myBid)) (finSub v (finVal (finMax r oppBid))) (finSub v (finVal v))
