-- vickreyReserve*, as in Lean.
def vickreyUtility : (n : Nat) -> (v b1 b2 : Fin n) -> Fin n :=
  fun (n : Nat) (v b1 b2 : Fin n) => flagIf (finLe b2 b1) (finSub v (finVal b2)) (finSub v (finVal v))
def vickreyBidder2Util : (n : Nat) -> (v oppBid myBid : Fin n) -> Fin n :=
  fun (n : Nat) (v oppBid myBid : Fin n) => flagIf (finLt oppBid myBid) (finSub v (finVal oppBid)) (finSub v (finVal v))
def spsbBidder1Utility : (n : Nat) -> (bid : (v : Fin n) -> Fin n) -> (v1 v2 : Fin n) -> Fin n :=
  fun (n : Nat) (bid : (v : Fin n) -> Fin n) (v1 v2 : Fin n) => vickreyUtility n v1 (bid v1) v2
def fpsbUtility : (n : Nat) -> (v b1 b2 : Fin n) -> Fin n :=
  fun (n : Nat) (v b1 b2 : Fin n) => flagIf (finLe b2 b1) (finSub v (finVal b1)) (finSub v (finVal v))
def fpsbReserveUtility : (n : Nat) -> (r v b1 b2 : Fin n) -> Fin n :=
  fun (n : Nat) (r v b1 b2 : Fin n) => flagIf (flagAnd (finLe b2 b1) (finLe r b1)) (finSub v (finVal b1)) (finSub v (finVal v))
