-- Open games over FinStoch (auction-cat OpenGamesCat/Basic.lean, the Optic
-- of comp-cat-theory Collapse/Optic.lean) and the bidders and auctions of
-- AuctionCat/Bidder.lean and Auction.lean (slice A4, D86-D94). The Makefile
-- joins this file after auction.lang, so each name here is a core name too
-- (rule R4). The Lean middle object M is the fifth family parameter m: each
-- combinator gives the m of its result in its type (D87). The open-game
-- layer has a game prefix (Lean id, comp, score, kron, make: D91).
family OpenGame (x : Nat) (s : Nat) (y : Nat) (r : Nat) (m : Nat) := makeGame (gameView : Matrix x (natMul m y)) (gameUpdate : Matrix (natMul m r) s)
-- The game layer: Basic.lean:50 id, :55 comp (Optic.lean:88), :68 score.
def gameId : (x : Nat) -> (s : Nat) -> OpenGame x s x s 1 :=
  fun (x : Nat) (s : Nat) => makeGame x s x s 1 (matLeftUnitorInv x) (matLeftUnitor s)
def gameComp : (x : Nat) -> (s : Nat) -> (y : Nat) -> (r : Nat) -> (z : Nat) -> (q : Nat) -> (m1 : Nat) -> (m2 : Nat) -> (f : OpenGame x s y r m1) -> (g : OpenGame y r z q m2) -> OpenGame x s z q (natMul m1 m2) :=
  fun (x : Nat) (s : Nat) (y : Nat) (r : Nat) (z : Nat) (q : Nat) (m1 : Nat) (m2 : Nat) (f : OpenGame x s y r m1) (g : OpenGame y r z q m2) => makeGame x s z q (natMul m1 m2) (matComp x (natMul m1 y) (natMul (natMul m1 m2) z) (gameView f) (matComp (natMul m1 y) (natMul m1 (natMul m2 z)) (natMul (natMul m1 m2) z) (matKron m1 m1 y (natMul m2 z) (matId m1) (gameView g)) (matAssociatorInv m1 m2 z))) (matComp (natMul (natMul m1 m2) q) (natMul m1 (natMul m2 q)) s (matAssociator m1 m2 q) (matComp (natMul m1 (natMul m2 q)) (natMul m1 r) s (matKron m1 m1 (natMul m2 q) r (matId m1) (gameUpdate g)) (gameUpdate f)))
def gameScore : (x : Nat) -> (s : Nat) -> (y : Nat) -> (r : Nat) -> (m : Nat) -> (g : OpenGame x s y r m) -> (k : Matrix y r) -> Matrix x s :=
  fun (x : Nat) (s : Nat) (y : Nat) (r : Nat) (m : Nat) (g : OpenGame x s y r m) (k : Matrix y r) => matComp x (natMul m y) s (gameView g) (matIdKronComp m y r s k (gameUpdate g))
-- The middle interchange (Basic.lean:80) as one matOfFn of its Fin form
-- (KernelTruth.lean:155), not the 5-matrix chain (D88), and kron (:104).
def middleInterchangeFn : (a : Nat) -> (b : Nat) -> (d : Nat) -> (e : Nat) -> (x : Fin (natMul (natMul a b) (natMul d e))) -> Fin (natMul (natMul a d) (natMul b e)) :=
  fun (a : Nat) (b : Nat) (d : Nat) (e : Nat) (x : Fin (natMul (natMul a b) (natMul d e))) => finPair (natMul a d) (natMul b e) (finPair a d (finFirst a b (finFirst (natMul a b) (natMul d e) x)) (finFirst d e (finSecond (natMul a b) (natMul d e) x))) (finPair b e (finSecond a b (finFirst (natMul a b) (natMul d e) x)) (finSecond d e (finSecond (natMul a b) (natMul d e) x)))
def matMiddleInterchange : (a : Nat) -> (b : Nat) -> (d : Nat) -> (e : Nat) -> Matrix (natMul (natMul a b) (natMul d e)) (natMul (natMul a d) (natMul b e)) :=
  fun (a : Nat) (b : Nat) (d : Nat) (e : Nat) => matOfFn (natMul (natMul a b) (natMul d e)) (natMul (natMul a d) (natMul b e)) (fun (i : Fin (natMul (natMul a b) (natMul d e))) => middleInterchangeFn a b d e i)
def gameKron : (x : Nat) -> (s : Nat) -> (y : Nat) -> (r : Nat) -> (x2 : Nat) -> (s2 : Nat) -> (y2 : Nat) -> (r2 : Nat) -> (m : Nat) -> (m2 : Nat) -> (f : OpenGame x s y r m) -> (g : OpenGame x2 s2 y2 r2 m2) -> OpenGame (natMul x x2) (natMul s s2) (natMul y y2) (natMul r r2) (natMul m m2) :=
  fun (x : Nat) (s : Nat) (y : Nat) (r : Nat) (x2 : Nat) (s2 : Nat) (y2 : Nat) (r2 : Nat) (m : Nat) (m2 : Nat) (f : OpenGame x s y r m) (g : OpenGame x2 s2 y2 r2 m2) => makeGame (natMul x x2) (natMul s s2) (natMul y y2) (natMul r r2) (natMul m m2) (matComp (natMul x x2) (natMul (natMul m y) (natMul m2 y2)) (natMul (natMul m m2) (natMul y y2)) (matKron x (natMul m y) x2 (natMul m2 y2) (gameView f) (gameView g)) (matMiddleInterchange m y m2 y2)) (matComp (natMul (natMul m m2) (natMul r r2)) (natMul (natMul m r) (natMul m2 r2)) (natMul s s2) (matMiddleInterchange m m2 r r2) (matKron (natMul m r) s (natMul m2 r2) s2 (gameUpdate f) (gameUpdate g)))
-- Bidders (Bidder.lean:49 make, :84, :97, :119): a bidder is an open game
-- with m = v (the Lean alias Bidder is not a def).
def makeBidder : (v : Nat) -> (u : Nat) -> (b : Nat) -> (a : Nat) -> (strategy : Matrix v (natMul v b)) -> (utility : Matrix (natMul v a) u) -> OpenGame v u b a v :=
  fun (v : Nat) (u : Nat) (b : Nat) (a : Nat) (strategy : Matrix v (natMul v b)) (utility : Matrix (natMul v a) u) => makeGame v u b a v strategy utility
def truthfulBidder : (n : Nat) -> OpenGame n n n (natMul 2 n) n :=
  fun (n : Nat) => makeBidder n n n (natMul 2 n) (matCopy n) (matOfFn (natMul n (natMul 2 n)) n (truthfulUtilityFn n))
def deviatorBidder : (n : Nat) -> (bid : (v : Fin n) -> Fin n) -> OpenGame n n n (natMul 2 n) n :=
  fun (n : Nat) (bid : (v : Fin n) -> Fin n) => makeBidder n n n (natMul 2 n) (matOfFn n (natMul n n) (fun (v : Fin n) => finPair n n v (bid v))) (matOfFn (natMul n (natMul 2 n)) n (truthfulUtilityFn n))
def halfShadeBidder : (n : Nat) -> OpenGame n n n (natMul 2 n) n :=
  fun (n : Nat) => deviatorBidder n (fun (v : Fin n) => halfShading n v)
-- Two-bidder auctions (Auction.lean:38-160): the score of a game against
-- an A3 mechanism. Bidder 1 is the low digit.
def auctionGame : (n : Nat) -> OpenGame (natMul n n) (natMul n n) (natMul n n) (natMul (natMul 2 n) (natMul 2 n)) (natMul n n) :=
  fun (n : Nat) => gameKron n n n (natMul 2 n) n n n (natMul 2 n) n n (truthfulBidder n) (truthfulBidder n)
def auctionScore : (n : Nat) -> (mech : Matrix (natMul n n) (natMul (natMul 2 n) (natMul 2 n))) -> Matrix (natMul n n) (natMul n n) :=
  fun (n : Nat) (mech : Matrix (natMul n n) (natMul (natMul 2 n) (natMul 2 n))) => gameScore (natMul n n) (natMul n n) (natMul n n) (natMul (natMul 2 n) (natMul 2 n)) (natMul n n) (auctionGame n) mech
def fpsbAuction : (n : Nat) -> Matrix (natMul n n) (natMul n n) :=
  fun (n : Nat) => auctionScore n (firstPriceSealedBid n)
def spsbAuction : (n : Nat) -> Matrix (natMul n n) (natMul n n) :=
  fun (n : Nat) => auctionScore n (secondPriceSealedBid n)
def auctionGameDeviator1 : (n : Nat) -> (bid : (v : Fin n) -> Fin n) -> OpenGame (natMul n n) (natMul n n) (natMul n n) (natMul (natMul 2 n) (natMul 2 n)) (natMul n n) :=
  fun (n : Nat) (bid : (v : Fin n) -> Fin n) => gameKron n n n (natMul 2 n) n n n (natMul 2 n) n n (deviatorBidder n bid) (truthfulBidder n)
def auctionScoreDeviator1 : (n : Nat) -> (bid : (v : Fin n) -> Fin n) -> (mech : Matrix (natMul n n) (natMul (natMul 2 n) (natMul 2 n))) -> Matrix (natMul n n) (natMul n n) :=
  fun (n : Nat) (bid : (v : Fin n) -> Fin n) (mech : Matrix (natMul n n) (natMul (natMul 2 n) (natMul 2 n))) => gameScore (natMul n n) (natMul n n) (natMul n n) (natMul (natMul 2 n) (natMul 2 n)) (natMul n n) (auctionGameDeviator1 n bid) mech
def spsbAuctionDeviator1 : (n : Nat) -> (bid : (v : Fin n) -> Fin n) -> Matrix (natMul n n) (natMul n n) :=
  fun (n : Nat) (bid : (v : Fin n) -> Fin n) => auctionScoreDeviator1 n bid (secondPriceSealedBid n)
def auctionGameDeviator2 : (n : Nat) -> (bid : (v : Fin n) -> Fin n) -> OpenGame (natMul n n) (natMul n n) (natMul n n) (natMul (natMul 2 n) (natMul 2 n)) (natMul n n) :=
  fun (n : Nat) (bid : (v : Fin n) -> Fin n) => gameKron n n n (natMul 2 n) n n n (natMul 2 n) n n (truthfulBidder n) (deviatorBidder n bid)
def auctionScoreDeviator2 : (n : Nat) -> (bid : (v : Fin n) -> Fin n) -> (mech : Matrix (natMul n n) (natMul (natMul 2 n) (natMul 2 n))) -> Matrix (natMul n n) (natMul n n) :=
