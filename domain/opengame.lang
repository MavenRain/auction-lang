def spsbReserveAuctionDeviator1 : (n : Nat) -> (r : Fin n) -> (bid : (v : Fin n) -> Fin n) -> Matrix (natMul n n) (natMul n n) :=
  fun (n : Nat) (r : Fin n) (bid : (v : Fin n) -> Fin n) => auctionScoreDeviator1 n bid (spsbReserve n r)
def spsbReserveAuctionDeviator2 : (n : Nat) -> (r : Fin n) -> (bid : (v : Fin n) -> Fin n) -> Matrix (natMul n n) (natMul n n) :=
